#!/usr/bin/env bash
# Pre-push gate — a CHANGE-SCOPED pre-flight for .github/workflows/ci.yml.
#
# CI is the AUTHORITATIVE full gate (it additionally runs e2e:rail + chromium,
# the render-binding rail, and the native compile lanes — it is a superset of
# this hook). This hook runs only the step-groups whose inputs are in the push
# diff, so a docs/scripts/spec-only push doesn't pay to regenerate every
# framework. It is conservative: an indeterminate range, a classifier failure,
# or PREPUSH_FULL=1 all fall back to the FULL sequence. It can over-skip
# relative to CI but never silently skips a step whose input changed; CI is
# the backstop.
#
# Scoping logic: scripts/prepush-scope.mjs (pure, unit-tested in
# scripts/prepush-scope.test.mjs). Step-group order is fail-fast for the cheap
# checks — install -> lint -> typecheck -> token build (once) -> token gates ->
# generate:check -> docs -> tests — then governed:rail, and AFTER the rail +
# drift diff the realization-audit group (iconography, behavior, a11y, styling
# ledgers, token resolvability). That placement mirrors ci.yml: those audits
# classify generated bytes, and the rail + drift diff just proved those bytes
# were regenerated and are the pushed bytes.
#
# Activate per clone:   git config core.hooksPath .githooks
# Emergency bypass:      git push --no-verify   (CI still runs)
# Force the full gate:   PREPUSH_FULL=1 git push
#
# Maintenance: when ci.yml changes its step LIST, update the step commands here
# AND scripts/prepush-scope.mjs's path->group mapping in lockstep. (The
# behavior/a11y realization audits drifted out of this hook exactly that way
# and were re-wired by PREPUSH-LOCKSTEP-01.)

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# --- environment floor: CI pins Node 22; refuse below it with a clear message
#     instead of a cryptic downstream failure ---
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$NODE_MAJOR" -lt 22 ]; then
  echo "[pre-push] FATAL: Node >= 22 required (CI pins Node 22); found $(node -v 2>/dev/null || echo 'no node')"
  exit 1
fi

SECONDS=0
say() { echo "[pre-push][+${SECONDS}s] $*"; }

ZERO="0000000000000000000000000000000000000000"

# Which commits are being pushed? Capture the tip + the remote sha from stdin.
PUSHING_COMMITS=false
TIP=""
REMOTE_SHA=""
while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ -n "${local_sha:-}" ] && [ "$local_sha" != "$ZERO" ]; then
    PUSHING_COMMITS=true
    TIP="$local_sha"
    REMOTE_SHA="${remote_sha:-}"
    break
  fi
done

if [ "$PUSHING_COMMITS" = false ]; then
  say "no commits to push; skipping gate"
  exit 0
fi

# --- determine the diff range (or fall back to FULL) ---
FULL=false
[ "${PREPUSH_FULL:-}" = "1" ] && FULL=true

BASE=""
if [ "$FULL" = false ]; then
  # Prefer the merge-base with origin/main (the full branch delta vs main);
  # fall back to the last-pushed remote sha; else FULL.
  if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    BASE="$(git merge-base origin/main "$TIP" 2>/dev/null || true)"
  fi
  if [ -z "$BASE" ] && [ -n "$REMOTE_SHA" ] && [ "$REMOTE_SHA" != "$ZERO" ]; then
    BASE="$REMOTE_SHA"
  fi
  [ -z "$BASE" ] && FULL=true
fi

CHANGED=""
if [ "$FULL" = false ]; then
  CHANGED="$(git diff --name-only "$BASE" "$TIP" || true)"
fi

# --- classify into RUN_* step-group flags (fail-safe to FULL on any error) ---
if [ "$FULL" = true ]; then
  FLAGS="$(node "$ROOT/scripts/prepush-scope.mjs" --full)" || FLAGS=""
else
  FLAGS="$(printf '%s\n' "$CHANGED" | node "$ROOT/scripts/prepush-scope.mjs")" \
    || FLAGS="$(node "$ROOT/scripts/prepush-scope.mjs" --full || true)"
fi
if [ -z "$FLAGS" ]; then
  say "classifier produced no output — running FULL gate"
  FLAGS="$(node "$ROOT/scripts/prepush-scope.mjs" --full)"
fi
eval "$FLAGS"

if [ "$FULL" = true ]; then
  say "$REASON"
else
  say "range ${BASE:0:9}..${TIP:0:9} — $REASON"
fi
echo ""

# --- install: when deps could have changed, when FULL, or when node_modules is
#     simply absent (fresh clone — every later step would fail confusingly) ---
NEED_INSTALL=false
if [ "$FULL" = true ]; then
  NEED_INSTALL=true
elif [ ! -d node_modules ]; then
  NEED_INSTALL=true
elif printf '%s\n' "$CHANGED" | grep -qE '(^|/)(pnpm-lock\.yaml|package\.json)$'; then
  NEED_INSTALL=true
fi
if [ "$NEED_INSTALL" = true ]; then
  say "install — pnpm install --frozen-lockfile"
  pnpm install --frozen-lockfile
else
  say "skip install (deps present, no package.json / lockfile change)"
fi

# --- fail-fast: lint + typecheck before the heavy token/rail work ---
if [ "${RUN_LINT:-false}" = true ]; then
  echo ""; say "lint — pnpm run lint"; pnpm run lint
else say "skip lint"; fi

if [ "${RUN_TYPECHECK:-false}" = true ]; then
  echo ""; say "typecheck (root + codegen)"; pnpm run typecheck
  say "typecheck:vue"; pnpm run typecheck:vue
else say "skip typecheck"; fi

# --- token build (once): tokens:build:check emits the composed graph that
#     generate:check needs AND runs the committed-output drift diff. This folds
#     the old standalone tokens:build into one step. ---
if [ "${RUN_TOKEN_BUILD:-false}" = true ]; then
  echo ""; say "tokens:build:check (build composed graph + drift diff)"
  pnpm run tokens:build:check
else say "skip token build"; fi

# --- token gates: only when ds-tokens source changed ---
if [ "${RUN_TOKEN_GATES:-false}" = true ]; then
  echo ""; say "tokens:validate"; pnpm run tokens:validate
  say "tokens:check-contrast"; pnpm run tokens:check-contrast
  say "tokens:check-brand-refs"; pnpm run tokens:check-brand-refs
  # tokens:check-usage is REPORT-ONLY (RAIL-TOKEN-REFERENCE-RESOLVABILITY-01).
  # It asks "is every declared token referenced?", which is the wrong health
  # question for a vocabulary layer: base and semantic exist to be drawn from,
  # and a brand may ship a palette ramp ahead of its consumer. Gating on
  # reference count made that legal act fail the build. The blocking question is
  # now the inverse — does every reference RESOLVE — and lives in
  # audit:token-resolvability below. See docs/architecture/tokens-architecture.md.
  say "tokens:check-usage (report-only)"; pnpm run tokens:check-usage || true
else say "skip token gates"; fi

# --- generate:check (reuses the composed graph built above) + docs claims ---
if [ "${RUN_GENERATE_CHECK:-false}" = true ]; then
  echo ""; say "generate:check"; pnpm run generate:check
else say "skip generate:check"; fi

if [ "${RUN_DOCS_CLAIMS:-false}" = true ]; then
  say "docs:check-claims"; pnpm run docs:check-claims
  say "docs:check-links"; pnpm run docs:check-links
else say "skip docs:check-claims + docs:check-links"; fi

# --- tests ---
if [ "${RUN_TESTS:-false}" = true ]; then
  echo ""; say "test (root) + test:vue"; pnpm test; pnpm run test:vue
else say "skip tests"; fi

# --- governed:rail + generated-tree drift diff ---
# The drift diff compares the PUSHED TIP COMMIT against the working tree
# (not index-vs-worktree): staged-but-uncommitted regen output would pass an
# index comparison and then fail CI, which checks the committed tree. Comparing
# against "$TIP" catches both staged and unstaged divergence from the bytes
# actually being pushed. (PREPUSH-LOCKSTEP-01.)
if [ "${RUN_RAIL:-false}" = true ]; then
  echo ""; say "governed:rail + framework-src diff vs pushed tip ${TIP:0:9}"
  pnpm run governed:rail
  if ! git diff --exit-code "$TIP" -- \
      packages/ds-react/src \
      packages/ds-vue/src \
      packages/ds-svelte/src \
      packages/ds-angular/src \
      packages/ds-lit/src \
      packages/ds-react-native/src \
      packages/ds-swiftui/Sources/DsSwiftUI/Components \
      packages/ds-swiftui/Sources/DsSwiftUI/primitives \
      packages/ds-jetpack-compose/library/src/main/kotlin/com/fullstackds/components; then
    echo ""
    say "generated framework src trees differ from the pushed tip after running"
    say "the rail. Commit the regen output before pushing. CI will reject otherwise."
    exit 1
  fi
else say "skip governed:rail"; fi

# --- realization-audit group: AFTER the rail + drift diff, mirroring ci.yml ---
# These audits classify generated bytes; the two steps above just proved those
# bytes were regenerated (governed:rail) and are the pushed bytes (drift diff
# vs "$TIP"). When RUN_RAIL is false the group classifies the existing working
# tree. Each flag fires on that audit's exact input surface — see
# scripts/prepush-scope.mjs.

# Iconography emission ledger: only when ds-iconography changed. Separate
# emission model from the codegen rail — the ledger gate proves the committed
# content-addressed edge set matches a fresh regeneration. Wired in by
# ICONOGRAPHY-TOKEN-DISCIPLINE-02 (Phase 4).
if [ "${RUN_ICONOGRAPHY:-false}" = true ]; then
  echo ""; say "iconography:ledger:check"
  pnpm run iconography:ledger:check
else say "skip iconography ledger"; fi

# Behavior-realization rail (RAIL-BEHAVIOR-REALIZATION-AUDIT-01): derives
# interactivity obligations (event wires, compound/disclosure wiring, portal
# consumption) from the LIVE contract corpus and asserts each is realized in
# the generated output. CI runs this in the gate job; wired into the hook in
# lockstep by PREPUSH-LOCKSTEP-01 (previously a push got its verdict only from
# CI, after the fact).
if [ "${RUN_BEHAVIOR_AUDIT:-false}" = true ]; then
  echo ""; say "audit:behavior-realization"
  pnpm run audit:behavior-realization
else say "skip audit:behavior-realization"; fi

# A11y-realization rail (RAIL-A11Y-REALIZATION-01): derives accessibility
# obligations (ARIA relationships, keyboard surfaces, focus strategies) from
# the LIVE contract corpus and asserts each is realized in the generated output
# of every rail-admitted family. Pre-existing debt is enumerated in
# scripts/a11y-realization-audit/known-gaps.json; the audit fails on any
# UNLEDGERED gap and on any STALE ledger entry. Same lockstep wiring.
if [ "${RUN_A11Y_AUDIT:-false}" = true ]; then
  echo ""; say "audit:a11y-realization"
  pnpm run audit:a11y-realization
else say "skip audit:a11y-realization"; fi

# Styling-realization ledgers (RAIL-STYLING-REALIZATION-LEDGERS-01).
# Two-directional ratchets over the dead-slot and pseudo-state matrices: a new
# finding that nobody ledgered fails, and so does a ledger entry that no longer
# reproduces. This is the GATE OF RECORD for both audits — CI runs them too,
# but the author gets the verdict here, before the push.
if [ "${RUN_STYLING_AUDITS:-false}" = true ]; then
  echo ""; say "audit:dead-slots + audit:pseudo-state + audit:state-suppression"
  pnpm run audit:dead-slots
  pnpm run audit:pseudo-state
  pnpm run audit:state-suppression
else say "skip styling-realization ledgers"; fi

# Token-reference resolvability (RAIL-TOKEN-REFERENCE-RESOLVABILITY-01). The
# blocking token gate, replacing the count-based usage gate demoted above. Fires
# when a generated stylesheet reads a --fsds-* name the token graph never
# declares — CSS falls back to the literal, so the property renders a plausible
# value while the token layer is decorative for it. Needs the composed graph, so
# it runs after the token build; the audit fails loudly rather than reporting
# every reference as broken if the graph is missing.
if [ "${RUN_TOKEN_RESOLVABILITY:-false}" = true ]; then
  echo ""; say "audit:token-resolvability"
  pnpm run audit:token-resolvability
else say "skip token-resolvability ledger"; fi

echo ""
say "all selected checks passed; proceeding with push"

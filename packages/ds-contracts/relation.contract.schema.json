{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "relation.contract.schema.json",
  "$ref": "#/definitions/relationalStructure",
  "definitions": {
    "relationalStructure": {
      "type": "object",
      "properties": {
        "relations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/name"
          },
          "additionalProperties": {
            "$ref": "#/definitions/relation"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relationship"
          }
        }
      },
      "required": [
        "relations"
      ],
      "additionalProperties": false,
      "title": "Relational structure (L0-L2)",
      "description": "The authoritative analytical object of ARCH-ANALYTICAL-RELATION-001: one or more named relations, each with a declared grain and typed fields, plus declared relationships between them. A single relation is the degenerate structure. Emitted from packages/ds-codegen/src/analytical/relation-model.ts; do not edit by hand."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "relation": {
      "type": "object",
      "properties": {
        "grain": {
          "anyOf": [
            {
              "type": "string",
              "const": "unknown"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            }
          ]
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/name"
          },
          "additionalProperties": {
            "$ref": "#/definitions/field"
          }
        }
      },
      "required": [
        "grain",
        "fields"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "string",
          "enum": [
            "nominal",
            "ordinal",
            "cyclic",
            "interval",
            "ratio",
            "count",
            "proportion",
            "index"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "scalar",
            "interval",
            "set",
            "distribution",
            "point"
          ]
        },
        "key": {
          "type": "boolean"
        },
        "unit": {
          "allOf": [
            {
              "$ref": "#/definitions/unit"
            }
          ]
        },
        "temporality": {
          "allOf": [
            {
              "$ref": "#/definitions/temporality"
            }
          ]
        },
        "order": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "total",
                "partial"
              ]
            },
            "values": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "period": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "whole": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "perRow": {
                  "$ref": "#/definitions/name"
                }
              },
              "required": [
                "perRow"
              ],
              "additionalProperties": false
            }
          ]
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "additivity": {
          "allOf": [
            {
              "$ref": "#/definitions/additivity"
            }
          ]
        },
        "permits": {
          "allOf": [
            {
              "$ref": "#/definitions/permits"
            }
          ]
        }
      },
      "required": [
        "scale"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "dimension": {
          "$ref": "#/definitions/dimension"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "perRow": {
          "type": "boolean"
        },
        "conversions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "rate": {
          "type": "object",
          "properties": {
            "numerator": {
              "$ref": "#/definitions/dimension"
            },
            "denominator": {
              "$ref": "#/definitions/dimension"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dimension"
      ],
      "additionalProperties": false
    },
    "dimension": {
      "type": "string",
      "enum": [
        "currency",
        "time",
        "length",
        "mass",
        "temperature",
        "dimensionless"
      ]
    },
    "temporality": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instant",
            "interval",
            "duration"
          ]
        },
        "closure": {
          "type": "string",
          "enum": [
            "half-open",
            "closed",
            "open"
          ]
        },
        "grain": {
          "type": "string",
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ]
        },
        "calendar": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "additivity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "additive"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "semi-additive"
            },
            "nonAdditiveAlong": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            }
          },
          "required": [
            "kind",
            "nonAdditiveAlong"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "non-additive"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ratio-measure"
            },
            "numerator": {
              "$ref": "#/definitions/name"
            },
            "denominator": {
              "$ref": "#/definitions/name"
            }
          },
          "required": [
            "kind",
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        }
      ]
    },
    "permits": {
      "type": "object",
      "properties": {
        "null": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "absent",
              "not-applicable",
              "censored",
              "suppressed",
              "unknown",
              "missing-after-join"
            ]
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "observed",
              "derived",
              "imputed",
              "layout-generated"
            ]
          }
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "interval",
              "distribution",
              "measurement-error",
              "rounded"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/definitions/ref"
        },
        "to": {
          "$ref": "#/definitions/ref"
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-one",
            "many-to-many"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "cardinality"
      ],
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "properties": {
        "relation": {
          "$ref": "#/definitions/name"
        },
        "field": {
          "$ref": "#/definitions/name"
        }
      },
      "required": [
        "relation",
        "field"
      ],
      "additionalProperties": false
    }
  }
}

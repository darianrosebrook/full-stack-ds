{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "relation.contract.schema.json",
  "title": "Relational structure (L0-L2)",
  "description": "The authoritative analytical object of ARCH-ANALYTICAL-RELATION-001 at stage 1: one or more named relations, each with a declared grain and typed fields, plus declared relationships between them. A single relation is the degenerate structure. Recursively closed: no metadata or extension bags, no free semantic strings. Field types declare which observation-level qualifiers they PERMIT (null kinds, provenance, uncertainty); each observation carries which it HAS (see fixture.schema.json). Nothing here knows about tasks, channels, coordinates, projections, combinators, or forms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["relations"],
  "properties": {
    "relations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/definitions/relation" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/definitions/relationship" }
    }
  },
  "definitions": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "dimension": { "enum": ["currency", "time", "length", "mass", "temperature", "dimensionless"] },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grain", "fields"],
      "properties": {
        "grain": {
          "oneOf": [
            { "const": "unknown" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/name" } }
          ]
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/definitions/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale"],
      "properties": {
        "scale": { "enum": ["nominal", "ordinal", "cyclic", "interval", "ratio", "count", "proportion", "index"] },
        "shape": { "enum": ["scalar", "interval", "set", "distribution", "point"] },
        "key": { "type": "boolean" },
        "unit": { "$ref": "#/definitions/unit" },
        "temporality": { "$ref": "#/definitions/temporality" },
        "order": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["total", "partial"] },
            "values": { "type": "array", "minItems": 2, "items": { "type": ["string", "number"] } }
          }
        },
        "period": { "type": "number", "exclusiveMinimum": 0 },
        "whole": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["perRow"],
              "properties": { "perRow": { "$ref": "#/definitions/name" } }
            }
          ]
        },
        "base": { "type": "string", "minLength": 1 },
        "additivity": { "$ref": "#/definitions/additivity" },
        "permits": { "$ref": "#/definitions/permits" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension"],
      "properties": {
        "dimension": { "$ref": "#/definitions/dimension" },
        "unit": { "type": "string", "minLength": 1 },
        "units": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "perRow": { "type": "boolean" },
        "conversions": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "$ref": "#/definitions/dimension" },
            "denominator": { "$ref": "#/definitions/dimension" }
          }
        }
      }
    },
    "temporality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["instant", "interval", "duration"] },
        "closure": { "enum": ["half-open", "closed", "open"] },
        "grain": { "enum": ["second", "minute", "hour", "day", "week", "month", "quarter", "year"] },
        "calendar": { "type": "string", "minLength": 1 }
      }
    },
    "additivity": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "additive" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nonAdditiveAlong"],
          "properties": {
            "kind": { "const": "semi-additive" },
            "nonAdditiveAlong": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/name" } }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "non-additive" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "numerator", "denominator"],
          "properties": {
            "kind": { "const": "ratio-measure" },
            "numerator": { "$ref": "#/definitions/name" },
            "denominator": { "$ref": "#/definitions/name" }
          }
        }
      ]
    },
    "permits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "null": { "type": "array", "items": { "enum": ["absent", "not-applicable", "censored", "suppressed", "unknown", "missing-after-join"] } },
        "provenance": { "type": "array", "items": { "enum": ["observed", "derived", "imputed", "layout-generated"] } },
        "uncertainty": { "type": "array", "items": { "enum": ["none", "interval", "distribution", "measurement-error", "rounded"] } }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "field"],
      "properties": { "relation": { "$ref": "#/definitions/name" }, "field": { "$ref": "#/definitions/name" } }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "cardinality"],
      "properties": {
        "from": { "$ref": "#/definitions/ref" },
        "to": { "$ref": "#/definitions/ref" },
        "cardinality": { "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"] }
      }
    }
  }
}

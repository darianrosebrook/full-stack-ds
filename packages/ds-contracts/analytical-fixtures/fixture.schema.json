{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fixture.schema.json",
  "title": "Analytical fixture (one JSONL line of fixtures.jsonl)",
  "description": "A stimulus for the stage-1 engine: a relational structure, one or more assertions, and optional evidence (rows with per-observation qualifiers, and a grain witness). Fixtures are answer-free by construction: this schema has no place for a case id, verdict, diagnostic, obligation, or colloquial name, and it is recursively closed so none can be smuggled in. The binding ledger (bindings.json) is the only thing that relates a fixture to a corpus case, and the fixture knows nothing of it. Fixtures are also data: structure plus evidence is the interchange shape any consumer that wants real rows can read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "structure", "assertions"],
  "properties": {
    "id": { "type": "string", "pattern": "^FX_[A-Z0-9_]+$" },
    "structure": { "$ref": "relation.contract.schema.json" },
    "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "assertion.schema.json" } },
    "evidence": { "$ref": "#/definitions/evidence" }
  },
  "definitions": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
              "additionalProperties": { "$ref": "#/definitions/observation" }
            }
          }
        },
        "grainWitness": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/name" } }
        }
      }
    },
    "observation": {
      "oneOf": [
        { "type": ["number", "string", "boolean"] },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": ["number", "string", "boolean"] },
            "unit": { "type": "string", "minLength": 1 },
            "null": { "enum": ["absent", "not-applicable", "censored", "suppressed", "unknown", "missing-after-join"] },
            "provenance": { "enum": ["observed", "derived", "imputed", "layout-generated"] },
            "uncertainty": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["none", "interval", "distribution", "measurement-error", "rounded"] },
                "error": { "type": "number", "minimum": 0 },
                "low": { "type": "number" },
                "high": { "type": "number" },
                "level": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              }
            }
          }
        }
      ]
    }
  }
}

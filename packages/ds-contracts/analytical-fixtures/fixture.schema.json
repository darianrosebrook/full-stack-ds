{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fixture.schema.json",
  "$ref": "#/definitions/fixture",
  "definitions": {
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FX_[A-Z0-9_]+$"
        },
        "structure": {
          "$ref": "#/definitions/relationalStructure"
        },
        "assertions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/assertion"
          }
        },
        "evidence": {
          "allOf": [
            {
              "$ref": "#/definitions/evidence"
            }
          ]
        }
      },
      "required": [
        "id",
        "structure",
        "assertions"
      ],
      "additionalProperties": false,
      "title": "Analytical fixture (one JSONL line of fixtures.jsonl)",
      "description": "A stimulus for the stage-1 engine: a relational structure, one or more assertions, and optional evidence. Answer-free by construction: no place for a case id, verdict, diagnostic, obligation, or form name. Emitted from packages/ds-codegen/src/analytical/relation-model.ts; do not edit by hand."
    },
    "relationalStructure": {
      "type": "object",
      "properties": {
        "relations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/name"
          },
          "additionalProperties": {
            "$ref": "#/definitions/relation"
          }
        },
        "peers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "minItems": 2,
            "type": "array",
            "items": {
              "$ref": "#/definitions/name"
            }
          }
        }
      },
      "required": [
        "relations"
      ],
      "additionalProperties": false,
      "title": "Relational structure (L0-L2 kernel)",
      "description": "The authoritative analytical object of ARCH-ANALYTICAL-RELATION-001 at stage 1.5: one or more named relations, each with a declared grain and typed fields. Every coordinate carries a necessity witness. Emitted from packages/ds-codegen/src/analytical/relation-model.ts; do not edit by hand."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "relation": {
      "type": "object",
      "properties": {
        "grain": {
          "anyOf": [
            {
              "type": "string",
              "const": "unknown"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            }
          ]
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/name"
          },
          "additionalProperties": {
            "$ref": "#/definitions/field"
          }
        },
        "derivedBy": {
          "allOf": [
            {
              "$ref": "#/definitions/derivation"
            }
          ]
        }
      },
      "required": [
        "grain",
        "fields"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "transformation": {
          "type": "string",
          "enum": [
            "nominal",
            "ordinal",
            "interval",
            "ratio"
          ]
        },
        "cyclic": {
          "type": "boolean",
          "const": true
        },
        "proportion": {
          "type": "boolean",
          "const": true
        },
        "index": {
          "type": "boolean",
          "const": true
        },
        "key": {
          "type": "boolean"
        },
        "unit": {
          "allOf": [
            {
              "$ref": "#/definitions/unit"
            }
          ]
        },
        "temporality": {
          "allOf": [
            {
              "$ref": "#/definitions/temporality"
            }
          ]
        },
        "whole": {
          "anyOf": [
            {
              "type": "string",
              "const": "fixed"
            },
            {
              "type": "object",
              "properties": {
                "perRow": {
                  "$ref": "#/definitions/name"
                }
              },
              "required": [
                "perRow"
              ],
              "additionalProperties": false
            }
          ]
        },
        "base": {
          "type": "boolean",
          "const": true
        },
        "additivity": {
          "allOf": [
            {
              "$ref": "#/definitions/additivity"
            }
          ]
        },
        "permits": {
          "allOf": [
            {
              "$ref": "#/definitions/permits"
            }
          ]
        }
      },
      "required": [
        "transformation"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "units": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "perRow": {
          "type": "boolean"
        },
        "conversions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "temporality": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instant",
            "interval"
          ]
        },
        "grain": {
          "type": "string",
          "enum": [
            "day",
            "month"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "additivity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "additive"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "semi-additive"
            },
            "nonAdditiveAlong": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            }
          },
          "required": [
            "kind",
            "nonAdditiveAlong"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "non-additive"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ratio-measure"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "permits": {
      "type": "object",
      "properties": {
        "null": {
          "type": "boolean",
          "const": true
        },
        "uncertainty": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "derivation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "aggregate-to-grain"
            },
            "from": {
              "$ref": "#/definitions/name"
            },
            "toGrain": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            }
          },
          "required": [
            "kind",
            "from",
            "toGrain"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "join"
            },
            "from": {
              "$ref": "#/definitions/name"
            },
            "with": {
              "$ref": "#/definitions/name"
            },
            "cardinality": {
              "type": "string",
              "enum": [
                "one-to-one",
                "one-to-many",
                "many-to-one",
                "many-to-many"
              ]
            }
          },
          "required": [
            "kind",
            "from",
            "with",
            "cardinality"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "nest"
            },
            "from": {
              "$ref": "#/definitions/name"
            },
            "levels": {
              "minItems": 2,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            }
          },
          "required": [
            "kind",
            "from",
            "levels"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bin"
            },
            "from": {
              "$ref": "#/definitions/name"
            },
            "field": {
              "$ref": "#/definitions/name"
            },
            "closure": {
              "type": "string",
              "enum": [
                "left-closed",
                "right-closed"
              ]
            }
          },
          "required": [
            "kind",
            "from",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "normalize"
            },
            "from": {
              "$ref": "#/definitions/name"
            },
            "field": {
              "$ref": "#/definitions/name"
            }
          },
          "required": [
            "kind",
            "from",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            },
            "from": {
              "$ref": "#/definitions/name"
            },
            "keep": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            }
          },
          "required": [
            "kind",
            "from",
            "keep"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "graph"
            },
            "from": {
              "$ref": "#/definitions/name"
            },
            "edgeFrom": {
              "$ref": "#/definitions/name"
            },
            "edgeTo": {
              "$ref": "#/definitions/name"
            },
            "value": {
              "allOf": [
                {
                  "$ref": "#/definitions/name"
                }
              ]
            },
            "requiresConservation": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "kind",
            "from",
            "edgeFrom",
            "edgeTo"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "aggregate"
            },
            "relation": {
              "$ref": "#/definitions/name"
            },
            "field": {
              "$ref": "#/definitions/name"
            },
            "op": {
              "type": "string",
              "enum": [
                "sum",
                "mean",
                "count",
                "min"
              ]
            },
            "along": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            },
            "nulls": {
              "type": "string",
              "enum": [
                "exclude",
                "as-zero",
                "as-observed"
              ]
            },
            "uncertainty": {
              "type": "string",
              "const": "propagate"
            }
          },
          "required": [
            "kind",
            "relation",
            "field",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ratio-comparison"
            },
            "relation": {
              "$ref": "#/definitions/name"
            },
            "field": {
              "$ref": "#/definitions/name"
            }
          },
          "required": [
            "kind",
            "relation",
            "field"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Stage-1 analytical assertion (L0-L2 grammar)",
      "description": "The closed set of operations a stage-1 engine can be asked to judge over a relational structure. Emitted from packages/ds-codegen/src/analytical/relation-model.ts; do not edit by hand."
    },
    "evidence": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/name"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/name"
              },
              "additionalProperties": {
                "$ref": "#/definitions/observation"
              }
            }
          }
        },
        "grainWitness": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/name"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/definitions/name"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "anyOf": [
        {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        {
          "$ref": "#/definitions/observationRecord"
        }
      ]
    },
    "observationRecord": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "null": {
          "type": "string",
          "enum": [
            "absent",
            "censored",
            "suppressed"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}

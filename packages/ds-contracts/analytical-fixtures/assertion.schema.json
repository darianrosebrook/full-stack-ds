{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "assertion.schema.json",
  "$ref": "#/definitions/assertion",
  "definitions": {
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "aggregate"
            },
            "relation": {
              "$ref": "#/definitions/name"
            },
            "field": {
              "$ref": "#/definitions/name"
            },
            "op": {
              "type": "string",
              "enum": [
                "sum",
                "mean",
                "count",
                "min",
                "max"
              ]
            },
            "along": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            },
            "nulls": {
              "type": "string",
              "enum": [
                "exclude",
                "as-zero",
                "as-observed"
              ]
            },
            "uncertainty": {
              "type": "string",
              "enum": [
                "propagate",
                "drop"
              ]
            }
          },
          "required": [
            "kind",
            "relation",
            "field",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ratio-comparison"
            },
            "relation": {
              "$ref": "#/definitions/name"
            },
            "field": {
              "$ref": "#/definitions/name"
            }
          },
          "required": [
            "kind",
            "relation",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rollup"
            },
            "relation": {
              "$ref": "#/definitions/name"
            },
            "field": {
              "$ref": "#/definitions/name"
            },
            "toGrain": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/name"
              }
            },
            "op": {
              "type": "string",
              "enum": [
                "sum",
                "mean",
                "rederive"
              ]
            }
          },
          "required": [
            "kind",
            "relation",
            "field",
            "toGrain",
            "op"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Stage-1 analytical assertion (L0-L2 grammar)",
      "description": "The closed set of operations a stage-1 engine can be asked to judge over a relational structure. Emitted from packages/ds-codegen/src/analytical/relation-model.ts; do not edit by hand."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}

  "constructors": {
    "aggregate-to-grain": {
      "disposition": "required",
      "cases": [
        "CASE_NESTED_SUBTOTALS_OFF_GRAIN",
        "CASE_PEER_TOTALS_AT_A_DIFFERENT_GRAIN",
        "CASE_DAILY_AND_MONTHLY_ON_ONE_AXIS"
      ],
      "transitionLaw": "Combines rows to a named coarser grain. The result's grain IS the target grain; the target must be drawn from the input, and every surviving field must come from it."
    },
    "join": {
      "disposition": "required",
      "cases": [
        "CASE_REVENUE_DOUBLE_COUNTED_AFTER_JOIN",
        "CASE_ORDER_COUNT_AFTER_LINE_JOIN"
      ],
      "transitionLaw": "Relates two relations at a declared cardinality. The cardinality names which side survives at row granularity; the other side's values are repeated once per match, and no field of the result may come from outside the two inputs."
    },
    "nest": {
      "disposition": "required",
      "cases": [
        "CASE_NESTED_SUBTOTALS_OFF_GRAIN",
        "CASE_FLATTENING_DISCARDS_NEST_MEMBERSHIP"
      ],
      "transitionLaw": "Imposes a hierarchy without combining rows. Its prefixes are the grains it declares, and its levels must survive into the result or the hierarchy it declares is unrecoverable."
    },
    "bin": {
      "disposition": "required",
      "cases": [
        "CASE_WHICH_BIN_GETS_TEN"
      ],
      "transitionLaw": "Partitions a field's range into intervals. The closure decides which side of each boundary owns a value that lands on it; binning a grain column coarsens the row set in a way the declaration does not pin down."
    },
    "normalize": {
      "disposition": "required",
      "cases": [
        "CASE_NORMALIZED_AVERAGES"
      ],
      "transitionLaw": "Rescales a field against a whole, which presumes the parts sum to that whole. The row set is unchanged."
    },
    "project": {
      "disposition": "required",
      "cases": [
        "CASE_FLATTENING_DISCARDS_NEST_MEMBERSHIP"
      ],
      "transitionLaw": "Keeps exactly the named fields. The grain survives iff every grain column is kept; the membership of a nested input is lost with any dropped level, before any projection is chosen."
    },
    "graph": {
      "disposition": "required",
      "cases": [
        "CASE_LEAKING_FLOW",
        "CASE_FLOW_CONSERVATION_EDGE_VALUES_UNSEEN"
      ],
      "transitionLaw": "Reads a relation as directed edges without changing which rows exist. A declared conservation requirement is a claim about edge VALUES and is discharged only by rows, never by the declaration."
    }
  },

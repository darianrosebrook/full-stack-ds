{
  "root": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    }
  },
  ".checkbox:hover .checkbox__indicator": {
    "checkbox.color.border.default": {
      "resolvesTo": "semantic.color.border.hover",
      "fallback": "#f29495"
    }
  },
  "input": {
    "position": {
      "literal": "absolute",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "padding": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "margin": {
      "literal": "-1px",
      "platforms": [
        "web"
      ]
    },
    "overflow": {
      "literal": "hidden",
      "platforms": [
        "web"
      ]
    },
    "clip": {
      "literal": "rect(0, 0, 0, 0)",
      "platforms": [
        "web"
      ]
    },
    "white-space": {
      "literal": "nowrap",
      "platforms": [
        "web"
      ]
    },
    "border": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    }
  },
  "indicator": {
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    },
    "position": {
      "literal": "relative",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "width": {
      "literal": "16px",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "height": {
      "literal": "16px",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "border-radius": {
      "resolvesTo": "checkbox.border.radius",
      "fallback": "4px"
    },
    "border-color": {
      "resolvesTo": "checkbox.color.border.default",
      "fallback": "#aeaeae"
    },
    "background-color": {
      "resolvesTo": "checkbox.color.background.default",
      "fallback": "#ffffff"
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "resolvesTo": "checkbox.border.width",
      "fallback": "1px"
    },
    "box-sizing": {
      "literal": "border-box",
      "platforms": [
        "web"
      ]
    },
    "transition-duration": {
      "resolvesTo": "checkbox.transition.duration",
      "fallback": "150ms"
    }
  },
  ":has(.checkbox__input:checked) .checkbox__indicator": {
    "checkbox.color.background.default": {
      "resolvesTo": "semantic.color.action.background.primary.default",
      "fallback": "#d9292b"
    }
  },
  ":has(.checkbox__input:disabled) .checkbox__indicator": {
    "checkbox.color.background.default": {
      "resolvesTo": "semantic.color.background.disabled",
      "fallback": "#cecece"
    }
  },
  ":has(.checkbox__input:focus-visible) .checkbox__indicator": {
    "outline-width": {
      "resolvesTo": "checkbox.focus.ring.width",
      "fallback": "2px"
    },
    "outline-color": {
      "resolvesTo": "checkbox.focus.ring.color",
      "fallback": "#0a65fe"
    },
    "outline-style": {
      "resolvesTo": "checkbox.focus.ring.style",
      "fallback": "solid"
    },
    "outline-offset": {
      "resolvesTo": "checkbox.focus.ring.offset",
      "fallback": "2px"
    }
  }
}

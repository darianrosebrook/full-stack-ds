{
  "$schema": "../../component.contract.schema.json",
  "name": "Checkbox",
  "description": "Binary or tri-state input for boolean selection. Supports indeterminate state for partial group selection.",
  "layer": "primitive",
  "category": "input",
  "fieldAssociation": "control",
  "formControl": {
    "part": "input",
    "channel": "checked",
    "valueModel": "boolean",
    "commit": "change"
  },
  "anatomy": {
    "parts": [
      "root",
      "input",
      "indicator"
    ],
    "details": {
      "root": {
        "description": "Checkbox control surface that groups the native input with its visual indicator.",
        "role": "root"
      },
      "input": {
        "tag": "input",
        "description": "Native checkbox input carrying checked state, disabled state, and form submission values.",
        "role": "trigger",
        "interactive": true,
        "focusable": true,
        "aria": {
          "attributes": [
            "aria-label",
            "aria-labelledby",
            "aria-checked"
          ]
        }
      },
      "indicator": {
        "description": "Visual checked or indeterminate mark paired with the native input state.",
        "role": "decoration"
      }
    },
    "dom": {
      "tag": "label",
      "part": "root",
      "children": [
        {
          "tag": "input",
          "part": "input",
          "attrs": {
            "type": "checkbox"
          },
          "bindings": {
            "checked": "channel:checked.value",
            "disabled": "prop:disabled",
            "name": "prop:name",
            "value": "prop:value",
            "aria-label": "prop:ariaLabel",
            "aria-labelledby": "prop:ariaLabelledby",
            "aria-checked": "conditional:prop:indeterminate|literal:mixed|channel:checked.value"
          },
          "properties": {
            "indeterminate": "prop:indeterminate"
          }
        },
        {
          "tag": "span",
          "part": "indicator",
          "attrs": {
            "aria-hidden": "true"
          }
        }
      ]
    }
  },
  "props": {
    "designed": {
      "members": [
        {
          "name": "size",
          "propType": { "kind": "ref", "to": "CheckboxSize" },
          "description": "Visual size variant.",
          "default": "md"
        },
        {
          "name": "checked",
          "propType": { "kind": "boolean" },
          "description": "Controlled checked state."
        },
        {
          "name": "defaultChecked",
          "propType": { "kind": "boolean" },
          "description": "Uncontrolled initial checked state."
        },
        {
          "name": "onChange",
          "propType": {
            "kind": "callback",
            "params": [{ "name": "checked", "type": { "kind": "boolean" } }],
            "returns": { "kind": "void" }
          },
          "description": "Called when checked state changes."
        },
        {
          "name": "indeterminate",
          "propType": { "kind": "boolean" },
          "description": "Renders indeterminate state (some-but-not-all children selected)."
        },
        {
          "name": "disabled",
          "propType": { "kind": "boolean" },
          "description": "Prevents interaction."
        },
        {
          "name": "name",
          "propType": { "kind": "string" },
          "description": "Form name for native submission."
        },
        {
          "name": "value",
          "propType": { "kind": "string" },
          "description": "Form value submitted when checked."
        },
        {
          "name": "ariaLabel",
          "propType": { "kind": "string" },
          "description": "Direct accessible name for the native checkbox input."
        },
        {
          "name": "ariaLabelledby",
          "propType": { "kind": "string" },
          "description": "Space-separated ids of elements that name the native checkbox input."
        }
      ]
    }
  },
  "channels": {
    "checked": {
      "value": "checked",
      "defaultValue": "defaultChecked",
      "onChange": "onChange",
      "valueType": "boolean",
      "description": "Whether the checkbox is checked."
    }
  },
  "types": {
    "CheckboxSize": {
      "kind": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ]
    }
  },
  "variants": {
    "size": [
      "sm",
      "md",
      "lg"
    ]
  },
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default",
          "hover"
        ],
        "initial": "default",
        "exclusive": true
      },
      "focus": {
        "category": "interaction",
        "values": [
          "unfocused",
          "focus"
        ],
        "initial": "unfocused",
        "exclusive": true
      },
      "availability": {
        "category": "availability",
        "effect": "restyle",
        "values": [
          "enabled",
          "disabled"
        ],
        "initial": "enabled",
        "exclusive": true,
        "suppresses": {
          "categories": [
            "interaction"
          ]
        }
      },
      "selection": {
        "category": "selection",
        "effect": "restyle",
        "values": [
          "unchecked",
          "checked"
        ],
        "initial": "unchecked",
        "exclusive": true,
        "a11y": {
          "attribute": "aria-checked",
          "values": {
            "unchecked": "false",
            "checked": "true"
          }
        }
      }
    }
  },
  "form": {
    "participates": true,
    "inputType": "checkbox",
    "name": {
      "prop": "name"
    },
    "serialization": {
      "valueType": "string",
      "valueSource": "prop:value",
      "omitWhen": "unchecked",
      "multiple": false
    },
    "validity": {
      "model": "native",
      "ariaAttributes": [
        "aria-invalid",
        "aria-required",
        "aria-describedby"
      ]
    },
    "labeling": {
      "strategy": "associated-label",
      "required": true,
      "via": [
        "aria-labelledby",
        "aria-label"
      ]
    }
  },
  "focus": {
    "strategy": "auto",
    "description": "Native checkbox receives focus via Tab. No custom roving or trap needed."
  },
  "portal": {
    "enabled": false
  },
  "slots": {
    "root": {
      "required": true,
      "selector": "[data-slot=\"checkbox\"]"
    },
    "input": {
      "required": true,
      "selector": "[data-slot=\"checkbox-input\"]"
    },
    "indicator": {
      "required": true,
      "selector": "[data-slot=\"checkbox-indicator\"]"
    }
  },
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "a11y": {
    "labeling": [
      "aria-label",
      "aria-labelledby",
      "aria-checked"
    ],
    "keyboard": [
      {
        "key": "Space",
        "action": "Toggle the checked state."
      }
    ]
  },
  "a2ui": {
    "category": "form-field",
    "usageHints": [
      "Use checked and onChange for controlled mode; defaultChecked for uncontrolled",
      "Set indeterminate for parent checkboxes in a group where some children are checked",
      "Always pair with a label — via ariaLabel, ariaLabelledby, or an associated visible Label component",
      "Use name and value for native form submission"
    ],
    "children": {
      "allowed": false
    }
  }
}

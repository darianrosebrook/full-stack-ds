{
  "root": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "justify-content": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "overflow": {
      "literal": "hidden",
      "platforms": [
        "web"
      ]
    },
    "position": {
      "literal": "relative",
      "platforms": [
        "web"
      ]
    },
    "border-radius": {
      "resolvesTo": "avatar.size.radius.default",
      "fallback": "9999px"
    },
    "background-color": {
      "resolvesTo": "avatar.color.background.default",
      "fallback": "#efefef"
    },
    "color": {
      "resolvesTo": "avatar.color.foreground.primary",
      "fallback": "#141414"
    },
    "border-color": {
      "resolvesTo": "avatar.color.border.default",
      "fallback": "#fceaea"
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "resolvesTo": "avatar.size.border.default",
      "fallback": "1px"
    },
    "width": {
      "resolvesTo": "avatar.size.default",
      "fallback": "16px"
    },
    "height": {
      "resolvesTo": "avatar.size.default",
      "fallback": "16px"
    },
    "font-weight": {
      "resolvesTo": "avatar.typography.fontWeight.medium",
      "fallback": "500"
    },
    "font-family": {
      "resolvesTo": "avatar.typography.fontFamily.sans",
      "fallback": "\"Inter\", sans-serif"
    }
  },
  "image": {
    "width": {
      "literal": "100%",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "100%",
      "platforms": [
        "web"
      ]
    },
    "object-fit": {
      "literal": "cover",
      "platforms": [
        "web"
      ]
    },
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    }
  },
  "--small": {
    "width": {
      "resolvesTo": "avatar.size.small",
      "fallback": "16px"
    },
    "height": {
      "resolvesTo": "avatar.size.small",
      "fallback": "16px"
    }
  },
  "--medium": {
    "width": {
      "resolvesTo": "avatar.size.medium",
      "fallback": "24px"
    },
    "height": {
      "resolvesTo": "avatar.size.medium",
      "fallback": "24px"
    }
  },
  "--large": {
    "width": {
      "resolvesTo": "avatar.size.large",
      "fallback": "32px"
    },
    "height": {
      "resolvesTo": "avatar.size.large",
      "fallback": "32px"
    }
  },
  "--extra-large": {
    "width": {
      "resolvesTo": "avatar.size.extra-large",
      "fallback": "48px"
    },
    "height": {
      "resolvesTo": "avatar.size.extra-large",
      "fallback": "48px"
    }
  }
}

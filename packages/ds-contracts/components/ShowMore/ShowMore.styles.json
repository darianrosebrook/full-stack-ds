{
  "root": {
    "background-color": {
      "resolvesTo": "show-more.color.background.default",
      "fallback": "#f7f7f7"
    },
    "color": {
      "resolvesTo": "show-more.color.foreground.secondary",
      "fallback": "#474647"
    },
    "padding": {
      "resolvesTo": "show-more.size.padding.default",
      "fallback": "24px"
    },
    "border-radius": {
      "resolvesTo": "show-more.size.radius.default",
      "fallback": "6px"
    }
  },
  "content": {
    "overflow": {
      "literal": "hidden",
      "platforms": [
        "web"
      ]
    },
    "display": {
      "literal": "-webkit-box",
      "platforms": [
        "web"
      ]
    },
    "-webkit-box-orient": {
      "literal": "vertical",
      "platforms": [
        "web"
      ]
    },
    "-webkit-line-clamp": {
      "literal": "var(--fsds-show-more-content-max-lines, 3)",
      "platforms": [
        "web"
      ]
    },
    "line-clamp": {
      "literal": "var(--fsds-show-more-content-max-lines, 3)",
      "platforms": [
        "web"
      ]
    }
  },
  ".show-more--expanded .show-more__content": {
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "-webkit-line-clamp": {
      "literal": "unset",
      "platforms": [
        "web"
      ]
    },
    "line-clamp": {
      "literal": "unset",
      "platforms": [
        "web"
      ]
    }
  },
  "trigger": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "show-more.color.foreground.primary",
      "fallback": "#141414"
    },
    "background": {
      "literal": "none",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "border-color": {
      "resolvesTo": "show-more.color.border.default",
      "fallback": "#b8b8b8"
    },
    "padding": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    }
  }
}

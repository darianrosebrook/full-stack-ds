{
  "root": {
    "color": {
      "resolvesTo": "blockquote.color.foreground.primary",
      "fallback": "#5c5b5c"
    },
    "background-color": {
      "resolvesTo": "blockquote.color.background.default",
      "fallback": "#d0d0d0"
    },
    "border-color": {
      "resolvesTo": "blockquote.color.border.default",
      "fallback": "#d92d2e"
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "border-radius": {
      "resolvesTo": "blockquote.size.radius.default",
      "fallback": "6px"
    },
    "padding": {
      "resolvesTo": "blockquote.size.padding.default",
      "fallback": "12px"
    },
    "font-size": {
      "resolvesTo": "blockquote.size.fontSize.md",
      "fallback": "1rem"
    },
    "font-style": {
      "resolvesTo": "blockquote.typography.fontStyle",
      "fallback": "italic"
    },
    "font-weight": {
      "resolvesTo": "blockquote.typography.fontWeight",
      "fallback": "500"
    },
    "margin": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    }
  },
  "--default": {
    "blockquote.color.background.default": {
      "resolvesTo": "semantic.color.background.secondary",
      "fallback": "#d0d0d0"
    },
    "border-width": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    }
  },
  "--bordered": {
    "blockquote.color.background.default": {
      "resolvesTo": "semantic.color.background.primary",
      "fallback": "#ffffff"
    },
    "blockquote.size.padding.default": {
      "resolvesTo": "core.spacing.size.05",
      "fallback": "12px"
    },
    "border-inline-start-width": {
      "resolvesTo": "blockquote.size.border.thick",
      "fallback": "2px"
    },
    "border-inline-start-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-inline-start-color": {
      "resolvesTo": "blockquote.color.border.default",
      "fallback": "#d92d2e"
    },
    "padding-inline-start": {
      "resolvesTo": "blockquote.size.padding.default",
      "fallback": "12px"
    }
  },
  "--highlighted": {
    "blockquote.color.background.default": {
      "resolvesTo": "semantic.color.background.accentSubtle",
      "fallback": "#95dafb"
    },
    "blockquote.color.foreground.primary": {
      "resolvesTo": "semantic.color.foreground.primary",
      "fallback": "#141414"
    }
  },
  "--sm": {
    "blockquote.size.padding.default": {
      "resolvesTo": "core.spacing.size.04",
      "fallback": "8px"
    },
    "blockquote.size.fontSize.md": {
      "resolvesTo": "core.typography.ramp.3",
      "fallback": "0.875rem"
    },
    "font-size": {
      "resolvesTo": "blockquote.size.fontSize.md",
      "fallback": "1rem"
    },
    "padding": {
      "resolvesTo": "blockquote.size.padding.default",
      "fallback": "12px"
    }
  },
  "--md": {
    "blockquote.size.padding.default": {
      "resolvesTo": "core.spacing.size.05",
      "fallback": "12px"
    },
    "blockquote.size.fontSize.md": {
      "resolvesTo": "core.typography.ramp.4",
      "fallback": "1rem"
    },
    "font-size": {
      "resolvesTo": "blockquote.size.fontSize.md",
      "fallback": "1rem"
    },
    "padding": {
      "resolvesTo": "blockquote.size.padding.default",
      "fallback": "12px"
    }
  },
  "--lg": {
    "blockquote.size.padding.default": {
      "resolvesTo": "core.spacing.size.07",
      "fallback": "24px"
    },
    "blockquote.size.fontSize.md": {
      "resolvesTo": "core.typography.ramp.5",
      "fallback": "1.125rem"
    },
    "font-size": {
      "resolvesTo": "blockquote.size.fontSize.md",
      "fallback": "1rem"
    },
    "padding": {
      "resolvesTo": "blockquote.size.padding.default",
      "fallback": "12px"
    }
  }
}

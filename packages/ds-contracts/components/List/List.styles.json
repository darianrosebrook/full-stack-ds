{
  "root": {
    "color": {
      "resolvesTo": "list.color.foreground.primary",
      "fallback": "#141414"
    },
    "border-color": {
      "resolvesTo": "list.color.border.default",
      "fallback": "#d0d0d0"
    },
    "padding": {
      "resolvesTo": "list.size.padding.default",
      "fallback": "16px"
    }
  },
  ".list--size-sm": {
    "font-size": {
      "resolvesTo": "list.size.sm",
      "fallback": "14px"
    }
  },
  ".list--size-md": {
    "font-size": {
      "resolvesTo": "list.size.md",
      "fallback": "16px"
    }
  },
  ".list--size-lg": {
    "font-size": {
      "resolvesTo": "list.size.lg",
      "fallback": "18px"
    }
  },
  ".list--spacing-none > * + *": {
    "margin-block-start": {
      "resolvesTo": "list.spacing.none",
      "fallback": "0px"
    }
  },
  ".list--spacing-sm > * + *": {
    "margin-block-start": {
      "resolvesTo": "list.spacing.sm",
      "fallback": "8px"
    }
  },
  ".list--spacing-md > * + *": {
    "margin-block-start": {
      "resolvesTo": "list.spacing.md",
      "fallback": "12px"
    }
  },
  ".list--spacing-lg > * + *": {
    "margin-block-start": {
      "resolvesTo": "list.spacing.lg",
      "fallback": "24px"
    }
  },
  ".list--marker-none": {
    "list-style-type": {
      "literal": "none",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--marker-disc": {
    "list-style-type": {
      "literal": "disc",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--marker-circle": {
    "list-style-type": {
      "literal": "circle",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--marker-square": {
    "list-style-type": {
      "literal": "square",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--marker-decimal": {
    "list-style-type": {
      "literal": "decimal",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--marker-alpha": {
    "list-style-type": {
      "literal": "lower-alpha",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--marker-roman": {
    "list-style-type": {
      "literal": "lower-roman",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--variant-unstyled": {
    "list-style": {
      "literal": "none",
      "platforms": [
        "web"
      ]
    },
    "padding": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "margin": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    }
  },
  ".list--variant-inline": {
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "flex-direction": {
      "literal": "row",
      "platforms": [
        "web"
      ]
    },
    "list-style": {
      "literal": "none",
      "platforms": [
        "web"
      ]
    },
    "gap": {
      "resolvesTo": "list.spacing.md",
      "fallback": "12px"
    }
  },
  ".list--variant-divided > * + *": {
    "border-block-start-width": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "border-block-start-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-block-start-color": {
      "resolvesTo": "list.color.border.default",
      "fallback": "#d0d0d0"
    }
  },
  ".list--variant-spaced > *": {
    "margin-block": {
      "resolvesTo": "list.spacing.lg",
      "fallback": "24px"
    }
  }
}

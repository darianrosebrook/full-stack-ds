  },
  "field.label.fontSize": {
    "resolvesTo": "semantic.typography.body.small.font.size",
    "fallback": "14px",
    "layer": "semantic"
  },
  "field.label.color": {
    "resolvesTo": "semantic.color.foreground.secondary",
    "fallback": "#5c5b5c",
    "layer": "semantic"
  },
  "field.focus.ring.width": {
    "resolvesTo": "semantic.focus.ring.width",

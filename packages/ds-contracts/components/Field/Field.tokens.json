    "layer": "semantic"
  },
  "field.color.validating-text": {
    "resolvesTo": "semantic.color.foreground.secondary",
    "fallback": "#5c5b5c",
    "layer": "semantic"
  },
  "field.color.valid-text": {
    "resolvesTo": "semantic.color.foreground.success",
    "fallback": "#497f21",
    "layer": "semantic"
  },
  "field.spacing.indicator": {
    "resolvesTo": "core.spacing.size.03",

{
  "root": {
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "flex-direction": {
      "literal": "column",
      "platforms": [
        "web"
      ]
    },
    "gap": {
      "resolvesTo": "field.gap.y",
      "fallback": "8px"
    },
    "border-radius": {
      "resolvesTo": "field.radius",
      "fallback": "6px"
    }
  },
  "label": {
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    },
    "font-size": {
      "resolvesTo": "field.label.fontSize",
      "fallback": "14px"
    },
    "font-weight": {
      "literal": "500",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "field.label.color",
      "fallback": "#5c5b5c"
    }
  },
  "header": {
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "baseline",
      "platforms": [
        "web"
      ]
    },
    "justify-content": {
      "literal": "space-between",
      "platforms": [
        "web"
      ]
    },
    "gap": {
      "resolvesTo": "field.gap.meta",
      "fallback": "4px"
    }
  },
  "control": {
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "flex-direction": {
      "literal": "column",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "100%",
      "platforms": [
        "web"
      ]
    },
    "box-sizing": {
      "literal": "border-box",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "border-radius": {
      "resolvesTo": "field.radius",
      "fallback": "6px"
    },
    "border-color": {
      "resolvesTo": "field.color.border",
      "fallback": "#d0d0d0"
    },
    "background-color": {
      "resolvesTo": "field.color.bg",
      "fallback": "#ffffff"
    },
    "padding": {
      "resolvesTo": "field.pad.x",
      "fallback": "12px"
    }
  },
  "help": {
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "font-size": {
      "literal": "0.875em",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "field.color.fg",
      "fallback": "#141414"
    }
  },
  "error": {
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "font-size": {
      "literal": "0.875em",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "field.color.invalid-text",
      "fallback": "#d92d2e"
    }
  },
  "meta": {
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "flex-direction": {
      "literal": "column",
      "platforms": [
        "web"
      ]
    },
    "gap": {
      "resolvesTo": "field.gap.meta",
      "fallback": "4px"
    }
  },
  "validatingIndicator": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "1em",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "1em",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "field.color.fg",
      "fallback": "#141414"
    }
  },
  ".field__control:focus-within": {
    "border-color": {
      "resolvesTo": "field.color.focus-border",
      "fallback": "#0566fe"
    },
    "outline-width": {
      "resolvesTo": "field.focus.ring.width",
      "fallback": "2px"
    },
    "outline-color": {
      "resolvesTo": "field.focus.ring.color",
      "fallback": "#0566fe"
    },
    "outline-style": {
      "resolvesTo": "field.focus.ring.style",
      "fallback": "solid"
    },
    "outline-offset": {
      "resolvesTo": "field.focus.ring.offset",
      "fallback": "2px"
    }
  },
  ".field--invalid .field__control": {
    "border-color": {
      "resolvesTo": "field.color.invalid-border",
      "fallback": "#b31b1b"
    }
  },
  ".field--disabled .field__control": {
    "opacity": {
      "literal": "0.5",
      "platforms": [
        "web"
      ]
    },
    "cursor": {
      "literal": "not-allowed",
      "platforms": [
        "web"
      ]
    }
  },
  ".field--valid .field__control": {
    "border-color": {
      "resolvesTo": "field.color.valid-border",
      "fallback": "#3a6614"
    }
  },
  "--idle": {
    "field.color.border": {
      "resolvesTo": "semantic.color.border.subtle",
      "fallback": "#d0d0d0"
    }
  },
  "--validating": {
    "field.color.border": {
      "resolvesTo": "semantic.color.border.accent",
      "fallback": "#d92d2e"
    },
    "field.color.fg": {
      "resolvesTo": "semantic.color.foreground.secondary",
      "fallback": "#5c5b5c"
    }
  },
  "--valid": {
    "field.color.border": {
      "resolvesTo": "semantic.color.feedback.border.success",
      "fallback": "#3a6614"
    },
    "field.color.fg": {
      "resolvesTo": "semantic.color.foreground.success",
      "fallback": "#497f21"
    }
  },
  "--invalid": {
    "field.color.border": {
      "resolvesTo": "semantic.color.border.danger",
      "fallback": "#b31b1b"
    },
    "field.color.fg": {
      "resolvesTo": "semantic.color.foreground.danger",
      "fallback": "#d92d2e"
    }
  }
}

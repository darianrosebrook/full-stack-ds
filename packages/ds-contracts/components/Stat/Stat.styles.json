{
  "root": {
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "stat.color.foreground.value",
      "fallback": "#141414"
    },
    "font-size": {
      "resolvesTo": "stat.size.value.md",
      "fallback": "24px"
    },
    "font-weight": {
      "resolvesTo": "stat.typography.weight.value",
      "fallback": "700"
    },
    "line-height": {
      "resolvesTo": "stat.typography.lineHeight.value",
      "platforms": [
        "web"
      ],
      "fallback": "1.1"
    },
    "letter-spacing": {
      "literal": "-0.02em",
      "platforms": [
        "web"
      ]
    }
  },
  "--up": {
    "color": {
      "resolvesTo": "stat.color.foreground.trend.up",
      "fallback": "#497f21"
    }
  },
  "--down": {
    "color": {
      "resolvesTo": "stat.color.foreground.trend.down",
      "fallback": "#d92d2e"
    }
  },
  "--neutral": {
    "color": {
      "resolvesTo": "stat.color.foreground.trend.neutral",
      "fallback": "#474647"
    }
  },
  "--sm": {
    "font-size": {
      "resolvesTo": "stat.size.value.sm",
      "fallback": "18px"
    }
  },
  "--lg": {
    "font-size": {
      "resolvesTo": "stat.size.value.lg",
      "fallback": "32px"
    }
  }
}

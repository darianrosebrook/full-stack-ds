{
  "root": {
    "background-color": {
      "resolvesTo": "breadcrumbs.color.background.elevated",
      "fallback": "#ffffff"
    },
    "border-color": {
      "resolvesTo": "breadcrumbs.color.border.subtle",
      "fallback": "#cecece"
    },
    "line-height": {
      "resolvesTo": "breadcrumbs.typography.lineHeight.collapse",
      "fallback": "1"
    },
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "border-radius": {
      "resolvesTo": "breadcrumbs.shape.radius.medium",
      "fallback": "8px"
    },
    "padding": {
      "resolvesTo": "breadcrumbs.spacing.padding.default",
      "fallback": "8px"
    },
    "color": {
      "resolvesTo": "breadcrumbs.color.foreground.primary",
      "fallback": "#141414"
    }
  },
  "focus": {
    "outline-color": {
      "resolvesTo": "breadcrumbs.color.focus",
      "fallback": "#d9292b"
    }
  },
  "list": {
    "list-style": {
      "literal": "none",
      "platforms": [
        "web"
      ]
    },
    "padding": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "margin": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "flex-wrap": {
      "literal": "wrap",
      "platforms": [
        "web"
      ]
    },
    "gap": {
      "resolvesTo": "breadcrumbs.spacing.gap.default",
      "fallback": "8px"
    }
  }
}

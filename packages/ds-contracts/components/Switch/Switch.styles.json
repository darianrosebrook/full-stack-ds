{
  "root": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    },
    "position": {
      "literal": "relative",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    }
  },
  "track": {
    "transition": {
      "literal": "background-color var(--fsds-switch-motion-duration) var(--fsds-switch-motion-easing)",
      "platforms": [
        "web"
      ]
    },
    "background-color": {
      "resolvesTo": "switch.color.track.background.default",
      "fallback": "#d0d0d0"
    },
    "border-color": {
      "resolvesTo": "switch.color.track.border.default",
      "fallback": "#d0d0d0"
    },
    "width": {
      "resolvesTo": "switch.size.md.track.width",
      "fallback": "48px"
    },
    "height": {
      "resolvesTo": "switch.size.md.track.height",
      "fallback": "24px"
    },
    "border-radius": {
      "resolvesTo": "switch.size.md.track.radius",
      "fallback": "9999px"
    },
    "padding": {
      "resolvesTo": "switch.size.md.track.padding",
      "fallback": "1px"
    },
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "position": {
      "literal": "relative",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "box-sizing": {
      "literal": "border-box",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "literal": "1px",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    }
  },
  "thumb": {
    "transition": {
      "literal": "translate var(--fsds-switch-motion-duration) var(--fsds-switch-motion-easing), background-color var(--fsds-switch-motion-duration) var(--fsds-switch-motion-easing)",
      "platforms": [
        "web"
      ]
    },
    "background-color": {
      "resolvesTo": "switch.color.thumb.background.default",
      "fallback": "#ffffff"
    },
    "box-shadow": {
      "resolvesTo": "switch.color.thumb.shadow.default",
      "fallback": "0px 1px 2px #0000000f, 0px 1px 3px #0000001a"
    },
    "width": {
      "resolvesTo": "switch.size.md.thumb.size",
      "fallback": "16px"
    },
    "height": {
      "resolvesTo": "switch.size.md.thumb.height",
      "fallback": "16px"
    },
    "top": {
      "resolvesTo": "switch.size.md.track.padding",
      "fallback": "1px"
    },
    "left": {
      "resolvesTo": "switch.size.md.track.padding",
      "fallback": "1px"
    },
    "translate": {
      "resolvesTo": "switch.size.md.thumb.translate.off",
      "fallback": "0"
    },
    "display": {
      "literal": "block",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "position": {
      "literal": "absolute",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "border-radius": {
      "literal": "50%",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "box-sizing": {
      "literal": "border-box",
      "platforms": [
        "web"
      ]
    }
  },
  "input": {
    "outline-color": {
      "resolvesTo": "switch.color.input.outline.focus",
      "fallback": "#0566fe"
    },
    "position": {
      "literal": "absolute",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "padding": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "margin": {
      "literal": "-1px",
      "platforms": [
        "web"
      ]
    },
    "overflow": {
      "literal": "hidden",
      "platforms": [
        "web"
      ]
    },
    "clip": {
      "literal": "rect(0, 0, 0, 0)",
      "platforms": [
        "web"
      ]
    },
    "white-space": {
      "literal": "nowrap",
      "platforms": [
        "web"
      ]
    },
    "border": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    }
  },
  ".switch:has(.switch__input:checked) .switch__track": {
    "switch.color.track.background.default": {
      "resolvesTo": "semantic.color.foreground.accent",
      "fallback": "#d92d2e"
    }
  },
  ".switch:has(.switch__input:checked) .switch__thumb": {
    "translate": {
      "resolvesTo": "switch.size.md.thumb.translate.on",
      "fallback": "24px"
    },
    "switch.color.thumb.background.default": {
      "resolvesTo": "semantic.color.foreground.on.brand",
      "fallback": "#ffffff"
    }
  },
  ".switch:has(.switch__input:disabled) .switch__track": {
    "switch.color.track.background.default": {
      "resolvesTo": "semantic.color.background.disabled",
      "fallback": "#d0d0d0"
    }
  },
  ".switch--sm .switch__track": {
    "width": {
      "resolvesTo": "switch.size.sm.track.width",
      "fallback": "32px"
    },
    "height": {
      "resolvesTo": "switch.size.sm.track.height",
      "fallback": "16px"
    },
    "border-radius": {
      "resolvesTo": "switch.size.sm.track.radius",
      "fallback": "9999px"
    },
    "padding": {
      "resolvesTo": "switch.size.sm.track.padding",
      "fallback": "1px"
    }
  },
  ".switch--sm .switch__thumb": {
    "width": {
      "resolvesTo": "switch.size.sm.thumb.size",
      "fallback": "12px"
    },
    "height": {
      "resolvesTo": "switch.size.sm.thumb.height",
      "fallback": "12px"
    },
    "top": {
      "resolvesTo": "switch.size.sm.track.padding",
      "fallback": "1px"
    },
    "left": {
      "resolvesTo": "switch.size.sm.track.padding",
      "fallback": "1px"
    },
    "translate": {
      "resolvesTo": "switch.size.sm.thumb.translate.off",
      "fallback": "0"
    }
  },
  ".switch--sm:has(.switch__input:checked) .switch__thumb": {
    "translate": {
      "resolvesTo": "switch.size.sm.thumb.translate.on",
      "fallback": "16px"
    }
  },
  ".switch--lg .switch__track": {
    "width": {
      "resolvesTo": "switch.size.lg.track.width",
      "fallback": "64px"
    },
    "height": {
      "resolvesTo": "switch.size.lg.track.height",
      "fallback": "32px"
    },
    "border-radius": {
      "resolvesTo": "switch.size.lg.track.radius",
      "fallback": "9999px"
    },
    "padding": {
      "resolvesTo": "switch.size.lg.track.padding",
      "fallback": "1px"
    }
  },
  ".switch--lg .switch__thumb": {
    "width": {
      "resolvesTo": "switch.size.lg.thumb.size",
      "fallback": "24px"
    },
    "height": {
      "resolvesTo": "switch.size.lg.thumb.height",
      "fallback": "24px"
    },
    "top": {
      "resolvesTo": "switch.size.lg.track.padding",
      "fallback": "1px"
    },
    "left": {
      "resolvesTo": "switch.size.lg.track.padding",
      "fallback": "1px"
    },
    "translate": {
      "resolvesTo": "switch.size.lg.thumb.translate.off",
      "fallback": "0"
    }
  },
  ".switch--lg:has(.switch__input:checked) .switch__thumb": {
    "translate": {
      "resolvesTo": "switch.size.lg.thumb.translate.on",
      "fallback": "36px"
    }
  }
}

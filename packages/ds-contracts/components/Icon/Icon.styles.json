{
  "root": {
    "color": {
      "literal": "currentColor",
      "platforms": [
        "web"
      ]
    },
    "box-sizing": {
      "literal": "border-box",
      "platforms": [
        "web"
      ]
    }
  },
  "--sm": {
    "width": {
      "resolvesTo": "icon.size.sm",
      "fallback": "16px"
    },
    "height": {
      "resolvesTo": "icon.size.sm",
      "fallback": "16px"
    }
  },
  "--md": {
    "width": {
      "resolvesTo": "icon.size.md",
      "fallback": "20px"
    },
    "height": {
      "resolvesTo": "icon.size.md",
      "fallback": "20px"
    }
  },
  "--lg": {
    "width": {
      "resolvesTo": "icon.size.lg",
      "fallback": "24px"
    },
    "height": {
      "resolvesTo": "icon.size.lg",
      "fallback": "24px"
    }
  },
  "--xl": {
    "width": {
      "resolvesTo": "icon.size.xl",
      "fallback": "32px"
    },
    "height": {
      "resolvesTo": "icon.size.xl",
      "fallback": "32px"
    }
  }
}

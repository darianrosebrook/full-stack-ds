{
  "root": {
    "position": {
      "literal": "relative",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    }
  },
  "trigger": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    }
  },
  "content": {
    "background-color": {
      "resolvesTo": "popover.color.background.content",
      "fallback": "#d0d0d0"
    },
    "border-color": {
      "resolvesTo": "popover.color.border.accent",
      "fallback": "#d92d2e"
    },
    "border-radius": {
      "resolvesTo": "popover.size.radius.default",
      "fallback": "6px"
    },
    "padding": {
      "resolvesTo": "popover.size.padding.default",
      "fallback": "16px"
    },
    "gap": {
      "resolvesTo": "popover.size.gap.default",
      "fallback": "8px"
    },
    "box-shadow": {
      "resolvesTo": "popover.elevation.default",
      "fallback": "0px 8px 10px #0000000a, 0px 20px 25px #0000001a"
    },
    "z-index": {
      "resolvesTo": "popover.layer.content",
      "fallback": "1000"
    },
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    }
  }
}

{
  "box-model.gap": {
    "resolvesTo": "semantic.structure.size.gap",
    "fallback": "16px",
    "layer": "semantic"
  },
  "tabs.spacing.gap": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "tabs.spacing.padding": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "tabs.spacing.pillPadding": {
    "literal": "4px 10px",
    "layer": "core"
  },
  "tabs.spacing.panelGap": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "tabs.color.fg": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "tabs.color.disabled-fg": {
    "resolvesTo": "semantic.color.foreground.disabled",
    "fallback": "#727272",
    "layer": "semantic"
  },
  "tabs.color.indicator": {
    "resolvesTo": "semantic.color.border.accent",
    "fallback": "#d92d2e",
    "layer": "semantic"
  },
  "tabs.shape.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "tabs.motion.indicator": {
    "resolvesTo": "core.motion.duration.short",
    "fallback": "150ms",
    "layer": "core"
  },
  "tabs.color.hover.bg": {
    "resolvesTo": "semantic.color.background.hover",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "tabs.color.hover.fg": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "tabs.color.active-fg": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "tabs.color.active-bg": {
    "resolvesTo": "semantic.color.background.secondary",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "tabs.color.focus": {
    "resolvesTo": "semantic.color.border.accent",
    "fallback": "#d92d2e",
    "layer": "semantic"
  },
  "tabs.color.underline.active": {
    "resolvesTo": "semantic.color.border.accent",
    "fallback": "#d92d2e",
    "layer": "semantic"
  },
  "tabs.size.indicator.thickness": {
    "literal": "2px"
  },
  "tabs.size.vertical.listWidth": {
    "literal": "160px"
  }
}

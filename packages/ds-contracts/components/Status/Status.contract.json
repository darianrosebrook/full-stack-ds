{
  "$schema": "../../component.contract.schema.json",
  "name": "Status",
  "description": "Compact icon-and-label pair conveying a status condition (online, offline, busy, etc.).",
  "layer": "primitive",
  "category": "feedback",
  "anatomy": {
    "parts": [
      "root",
      "icon",
      "label"
    ],
    "details": {
      "root": {
        "tag": "span",
        "description": "Inline status pair grouping the visual status icon and text label.",
        "role": "root"
      },
      "icon": {
        "componentRef": "fsds.Icon",
        "description": "Visual status glyph derived from the status prop; hidden from assistive technology.",
        "role": "decoration"
      },
      "label": {
        "tag": "span",
        "description": "Visible status text supplied by the component content.",
        "role": "label"
      }
    },
    "dom": {
      "tag": "span",
      "part": "root",
      "children": [
        {
          "componentRef": "fsds.Icon",
          "part": "icon",
          "attrs": {
            "size": "sm"
          },
          "bindings": {
            "name": {
              "kind": "map",
              "source": "prop:status",
              "values": {
                "info": "info",
                "success": "check",
                "warning": "triangle-alert",
                "danger": "triangle-alert",
                "error": "triangle-alert"
              }
            }
          }
        },
        {
          "tag": "span",
          "part": "label",
          "children": [
            {
              "tag": "children"
            }
          ]
        }
      ]
    }
  },
  "props": {
    "designed": {
      "members": [
        {
          "name": "status",
          "propType": { "kind": "ref", "to": "StatusIntent" },
          "description": "Status intent that drives the icon and color scheme.",
          "required": true
        }
      ]
    }
  },
  "types": {
    "StatusIntent": {
      "kind": "union",
      "values": [
        "info",
        "success",
        "warning",
        "danger",
        "error"
      ]
    }
  },
  "variants": {
    "status": [
      "info",
      "success",
      "warning",
      "danger",
      "error"
    ]
  },
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default"
        ],
        "initial": "default",
        "exclusive": true
      }
    }
  },
  "slots": {
    "root": {
      "required": true,
      "selector": "[data-slot=\"status\"]"
    },
    "icon": {
      "required": true,
      "selector": "[data-slot=\"status-icon\"]"
    },
    "label": {
      "required": true,
      "selector": "[data-slot=\"status-label\"]"
    }
  },
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "a11y": {
    "labeling": [
      "aria-label"
    ],
    "keyboard": []
  },
  "a2ui": {
    "category": "display",
    "usageHints": [
      "The icon is chosen automatically based on the status prop value",
      "Pair with Avatar to show user presence",
      "Use size to match surrounding text"
    ],
    "children": {
      "allowed": true
    }
  }
}

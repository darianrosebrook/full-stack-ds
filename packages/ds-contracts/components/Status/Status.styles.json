{
  "root": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "justify-content": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "box-sizing": {
      "literal": "border-box",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "fit-content",
      "platforms": [
        "web"
      ]
    },
    "white-space": {
      "literal": "nowrap",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "background-color": {
      "resolvesTo": "status.color.background.default",
      "fallback": "#d0d0d0"
    },
    "color": {
      "resolvesTo": "status.color.foreground.primary",
      "fallback": "#5c5b5c"
    },
    "border-color": {
      "resolvesTo": "status.color.border.default",
      "fallback": "#d0d0d0"
    },
    "border-width": {
      "resolvesTo": "status.size.border.default",
      "fallback": "1px"
    },
    "border-radius": {
      "resolvesTo": "status.size.radius.default",
      "fallback": "9999px"
    },
    "min-height": {
      "resolvesTo": "status.size.minHeight",
      "fallback": "24px"
    },
    "font-size": {
      "resolvesTo": "status.size.fontSize",
      "fallback": "12px"
    },
    "font-weight": {
      "resolvesTo": "status.text.weight",
      "fallback": "500"
    },
    "line-height": {
      "resolvesTo": "status.typography.lineHeight",
      "fallback": "1"
    }
  },
  "icon": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "flex-shrink": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "1em",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "1em",
      "platforms": [
        "web"
      ]
    }
  },
  "label": {
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "status.color.foreground.primary",
      "fallback": "#5c5b5c"
    }
  },
  "--info": {
    "status.color.background.default": {
      "resolvesTo": "semantic.color.background.info.subtle",
      "fallback": "#95dafb"
    },
    "status.color.foreground.primary": {
      "resolvesTo": "semantic.color.foreground.on.info.subtle",
      "fallback": "#013ab0"
    },
    "status.color.border.default": {
      "resolvesTo": "semantic.color.border.info",
      "fallback": "#034fd6"
    }
  },
  "--success": {
    "status.color.background.default": {
      "resolvesTo": "semantic.color.background.success.subtle",
      "fallback": "#b3dba7"
    },
    "status.color.foreground.primary": {
      "resolvesTo": "semantic.color.foreground.on.success.subtle",
      "fallback": "#2c4f09"
    },
    "status.color.border.default": {
      "resolvesTo": "semantic.color.border.success",
      "fallback": "#3a6614"
    }
  },
  "--warning": {
    "status.color.background.default": {
      "resolvesTo": "semantic.color.background.warning.subtle",
      "fallback": "#fdc67f"
    },
    "status.color.foreground.primary": {
      "resolvesTo": "semantic.color.foreground.on.warning.subtle",
      "fallback": "#6c3a00"
    },
    "status.color.border.default": {
      "resolvesTo": "semantic.color.border.warning",
      "fallback": "#8b4b00"
    }
  },
  "--danger": {
    "status.color.background.default": {
      "resolvesTo": "semantic.color.background.danger.subtle",
      "fallback": "#fac2c2"
    },
    "status.color.foreground.primary": {
      "resolvesTo": "semantic.color.foreground.on.danger.subtle",
      "fallback": "#900909"
    },
    "status.color.border.default": {
      "resolvesTo": "semantic.color.border.danger",
      "fallback": "#b31b1b"
    }
  },
  "--error": {
    "status.color.background.default": {
      "resolvesTo": "semantic.color.background.danger.subtle",
      "fallback": "#fac2c2"
    },
    "status.color.foreground.primary": {
      "resolvesTo": "semantic.color.foreground.on.danger.subtle",
      "fallback": "#900909"
    },
    "status.color.border.default": {
      "resolvesTo": "semantic.color.border.danger",
      "fallback": "#b31b1b"
    }
  }
}

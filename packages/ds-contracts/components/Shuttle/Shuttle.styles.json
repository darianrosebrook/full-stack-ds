{
  "root": {
    "background-color": {
      "resolvesTo": "shuttle.color.background.default",
      "fallback": "#f7f7f7"
    },
    "border-color": {
      "resolvesTo": "shuttle.color.border.accent",
      "fallback": "#d92d2e"
    },
    "padding": {
      "resolvesTo": "shuttle.size.padding.default",
      "fallback": "24px"
    },
    "border-radius": {
      "resolvesTo": "shuttle.size.radius.default",
      "fallback": "6px"
    }
  },
  "item": {
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "padding": {
      "literal": "4px 8px",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "shuttle.color.foreground.primary",
      "fallback": "#141414"
    },
    "border-block-end-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-block-end-width": {
      "literal": "1px",
      "platforms": [
        "web"
      ]
    },
    "border-block-end-color": {
      "resolvesTo": "shuttle.color.border.default",
      "fallback": "#b8b8b8"
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    }
  }
}

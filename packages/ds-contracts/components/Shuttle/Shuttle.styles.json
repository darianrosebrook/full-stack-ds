{
  "root": {
    "background-color": {
      "resolvesTo": "shuttle.color.background.default",
      "fallback": "#efefef"
    },
    "border-color": {
      "resolvesTo": "shuttle.color.border.accent",
      "fallback": "#d9292b"
    },
    "padding": {
      "resolvesTo": "shuttle.size.padding.default",
      "fallback": "24px"
    },
    "border-radius": {
      "resolvesTo": "shuttle.size.radius.default",
      "fallback": "8px"
    }
  },
  "item": {
    "display": {
      "literal": "flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "padding": {
      "literal": "4px 8px",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "shuttle.color.foreground.primary",
      "fallback": "#141414"
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    }
  }
}

{
  "root": {
    "color": {
      "resolvesTo": "progress.color.text.default",
      "fallback": "#474647"
    },
    "gap": {
      "resolvesTo": "progress.spacing.gap",
      "fallback": "2px"
    },
    "transition-duration": {
      "resolvesTo": "progress.motion.duration.indeterminate",
      "fallback": "1500ms"
    }
  },
  "track": {
    "background-color": {
      "resolvesTo": "progress.color.track.background",
      "fallback": "#f7f7f7"
    },
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "100%",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "100%",
      "platforms": [
        "web"
      ]
    },
    "overflow": {
      "literal": "hidden",
      "platforms": [
        "web"
      ]
    }
  },
  "fill": {
    "background-color": {
      "resolvesTo": "progress.color.fill.info",
      "fallback": "#0566fe"
    },
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "100%",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "calc(var(--fsds-progress-fill-width, 0) * 1%)",
      "platforms": [
        "web"
      ]
    }
  },
  "value": {
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "progress.color.text.default",
      "fallback": "#474647"
    },
    "font-size": {
      "literal": "0.875em",
      "platforms": [
        "web"
      ]
    },
    "margin-left": {
      "resolvesTo": "progress.spacing.gap",
      "fallback": "2px"
    }
  },
  ".progress--info .progress__fill": {
    "background-color": {
      "resolvesTo": "progress.color.fill.info",
      "fallback": "#0566fe"
    }
  },
  ".progress--success .progress__fill": {
    "background-color": {
      "resolvesTo": "progress.color.fill.success",
      "fallback": "#497f21"
    }
  },
  ".progress--warning .progress__fill": {
    "background-color": {
      "resolvesTo": "progress.color.fill.warning",
      "fallback": "#ae5d00"
    }
  },
  ".progress--danger .progress__fill": {
    "background-color": {
      "resolvesTo": "progress.color.fill.danger",
      "fallback": "#d92d2e"
    }
  }
}

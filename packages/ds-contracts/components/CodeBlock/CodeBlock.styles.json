{
  "root": {
    "background-color": {
      "resolvesTo": "code-block.color.background.default",
      "fallback": "#d0d0d0"
    },
    "border-color": {
      "resolvesTo": "code-block.color.border.default",
      "fallback": "#d0d0d0"
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "resolvesTo": "code-block.size.border.default",
      "fallback": "1px"
    },
    "border-radius": {
      "resolvesTo": "code-block.size.radius.default",
      "fallback": "6px"
    },
    "color": {
      "resolvesTo": "code-block.color.foreground.primary",
      "fallback": "#141414"
    },
    "font-family": {
      "literal": "ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
      "platforms": [
        "web"
      ]
    },
    "font-size": {
      "resolvesTo": "code-block.size.fontSize.default",
      "fallback": "0.875rem"
    },
    "line-height": {
      "resolvesTo": "code-block.typography.lineHeight.default",
      "fallback": "1.5"
    },
    "margin": {
      "literal": "0",
      "platforms": [
        "web"
      ]
    },
    "overflow-x": {
      "literal": "auto",
      "platforms": [
        "web"
      ]
    },
    "padding": {
      "resolvesTo": "code-block.size.padding.default",
      "fallback": "16px"
    },
    "tab-size": {
      "literal": "2",
      "platforms": [
        "web"
      ]
    },
    "white-space": {
      "literal": "pre",
      "platforms": [
        "web"
      ]
    }
  },
  "code": {
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "font-family": {
      "literal": "inherit",
      "platforms": [
        "web"
      ]
    },
    "font-size": {
      "literal": "inherit",
      "platforms": [
        "web"
      ]
    }
  },
  ".code-block__token[data-token=\"plain\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.plain",
      "fallback": "#141414"
    }
  },
  ".code-block__token[data-token=\"comment\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.comment",
      "fallback": "#727272"
    }
  },
  ".code-block__token[data-token=\"keyword\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.keyword",
      "fallback": "#0566fe"
    }
  },
  ".code-block__token[data-token=\"definition\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.definition",
      "fallback": "#d92d2e"
    }
  },
  ".code-block__token[data-token=\"punctuation\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.punctuation",
      "fallback": "#0566fe"
    }
  },
  ".code-block__token[data-token=\"property\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.property",
      "fallback": "#ae5d00"
    }
  },
  ".code-block__token[data-token=\"static\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.static",
      "fallback": "#d92d2e"
    }
  },
  ".code-block__token[data-token=\"string\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.string",
      "fallback": "#900909"
    }
  },
  ".code-block__token[data-token=\"tag\"]": {
    "color": {
      "resolvesTo": "code-block.token.color.tag",
      "fallback": "#d92d2e"
    }
  }
}

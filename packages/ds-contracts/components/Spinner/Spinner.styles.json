{
  "root": {
    "transition-duration": {
      "resolvesTo": "spinner.anim.duration",
      "fallback": "800ms"
    }
  },
  "visual": {
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    },
    "width": {
      "literal": "1em",
      "platforms": [
        "web"
      ]
    },
    "height": {
      "literal": "1em",
      "platforms": [
        "web"
      ]
    },
    "box-sizing": {
      "literal": "border-box",
      "platforms": [
        "web"
      ]
    },
    "border-radius": {
      "literal": "50%",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ]
    },
    "border-width": {
      "resolvesTo": "spinner.thickness.regular",
      "fallback": "3px"
    },
    "border-color": {
      "resolvesTo": "spinner.color.track",
      "fallback": "#d0d0d0"
    },
    "border-top-color": {
      "resolvesTo": "spinner.color.accent",
      "fallback": "#d92d2e"
    },
    "animation": {
      "literal": "spin var(--fsds-spinner-anim-duration, 800ms) linear infinite",
      "platforms": [
        "web"
      ]
    }
  },
  "--xs": {
    "font-size": {
      "resolvesTo": "spinner.size.xs",
      "fallback": "12px"
    }
  },
  "--sm": {
    "font-size": {
      "resolvesTo": "spinner.size.sm",
      "fallback": "16px"
    }
  },
  "--md": {
    "font-size": {
      "resolvesTo": "spinner.size.md",
      "fallback": "20px"
    }
  },
  "--lg": {
    "font-size": {
      "resolvesTo": "spinner.size.lg",
      "fallback": "24px"
    }
  },
  ".spinner--hairline .spinner__visual": {
    "border-width": {
      "resolvesTo": "spinner.thickness.hairline",
      "fallback": "2px"
    }
  },
  ".spinner--regular .spinner__visual": {
    "border-width": {
      "resolvesTo": "spinner.thickness.regular",
      "fallback": "3px"
    }
  },
  ".spinner--bold .spinner__visual": {
    "border-width": {
      "resolvesTo": "spinner.thickness.bold",
      "fallback": "4px"
    }
  }
}

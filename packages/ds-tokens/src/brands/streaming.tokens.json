{
  "$brand": {
    "name": "streaming",
    "description": "Media-focused UI with heavy sans-serif headings, pill actions and restrained borderless content surfaces.",
    "accent": "lime",
    "density": "compact"
  },
  "color": {
    "foreground": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.lime.600}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.600}",
          "fsds.dark": "{color.palette.lime.300}"
        },
        "$description": "Accent foreground - deep lime in light for legibility on white, bright lime pop in dark"
      },
      "link": {
        "$type": "color",
        "$value": "{color.palette.lime.600}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.600}",
          "fsds.dark": "{color.palette.lime.300}"
        }
      },
      "linkHover": {
        "$type": "color",
        "$value": "{color.palette.lime.700}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.700}",
          "fsds.dark": "{color.palette.lime.200}"
        }
      },
      "linkVisited": {
        "$type": "color",
        "$value": "{color.palette.lime.500}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.500}",
          "fsds.dark": "{color.palette.lime.400}"
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.lime.800}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.800}",
          "fsds.dark": "{color.palette.lime.100}"
        }
      }
    },
    "background": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.lime.600}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.600}",
          "fsds.dark": "{color.palette.lime.600}"
        },
        "$description": "Accent fill - lime.600 clears AA with white/near-black text in both modes"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.lime.100}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.100}",
          "fsds.dark": "{color.palette.lime.800}"
        }
      }
    },
    "border": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.lime.600}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.600}",
          "fsds.dark": "{color.palette.lime.400}"
        }
      },
      "default": {
        "$type": "color",
        "$value": "{color.palette.neutral.200}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.200}",
          "fsds.dark": "{color.palette.neutral.700}"
        },
        "$description": "Kept deliberately near-invisible - streaming surfaces separate by contrast, not hairlines"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.palette.lime.400}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.400}",
          "fsds.dark": "{color.palette.lime.500}"
        }
      },
      "focus": {
        "$type": "color",
        "$value": "{color.palette.lime.600}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.600}",
          "fsds.dark": "{color.palette.lime.400}"
        }
      },
      "light": {
        "$type": "color",
        "$value": "{color.palette.neutral.100}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.100}",
          "fsds.dark": "{color.palette.neutral.800}"
        }
      },
      "primary": {
        "$type": "color",
        "$value": "{color.palette.neutral.200}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.200}",
          "fsds.dark": "{color.palette.neutral.700}"
        }
      }
    },
    "navigation": {
      "foreground": {
        "active": {
          "$type": "color",
          "$value": "{color.palette.lime.600}",
          "$extensions": {
            "fsds.light": "{color.palette.lime.600}",
            "fsds.dark": "{color.palette.lime.300}"
          }
        }
      },
      "stateLayer": {
        "hover": {
          "$type": "number",
          "$value": "{interaction.stateLayer.hover}"
        },
        "selected": {
          "$type": "number",
          "$value": "{interaction.stateLayer.selected}"
        },
        "pressed": {
          "$type": "number",
          "$value": "{interaction.stateLayer.pressed}"
        }
      }
    },
    "action": {
      "background": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.lime.600}",
            "$description": "Primary CTA fill - lime.600, ~6.8:1 against white text"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.palette.lime.700}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.palette.lime.800}"
          }
        }
      },
      "border": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.lime.600}"
          },
          "focus": {
            "$type": "color",
            "$value": "{color.palette.lime.400}"
          }
        }
      }
    },
    "status": {
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.lime.300}",
        "$extensions": {
          "fsds.light": "{color.palette.lime.300}",
          "fsds.dark": "{color.palette.lime.400}"
        }
      }
    }
  },
  "shape": {
    "control": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "8px",
          "$description": "Default small control corner; content surfaces and actions have component-specific shape decisions."
        }
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "12px"
      },
      "border": {
        "light": {
          "$type": "color",
          "$value": "{color.mode.transparent}",
          "$extensions": {
            "fsds.light": "{color.mode.transparent}",
            "fsds.dark": "{color.mode.transparent}"
          },
          "$description": "No border by default - flat borderless cards rely on surface contrast"
        },
        "medium": {
          "$type": "color",
          "$value": "{color.palette.neutral.200}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.200}",
            "fsds.dark": "{color.palette.neutral.700}"
          }
        },
        "dark": {
          "$type": "color",
          "$value": "{color.palette.neutral.400}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.400}",
            "fsds.dark": "{color.palette.neutral.500}"
          }
        },
        "transparent": {
          "$type": "color",
          "$value": "{color.mode.transparent}",
          "$extensions": {
            "fsds.light": "{color.mode.transparent}",
            "fsds.dark": "{color.mode.transparent}"
          }
        }
      },
      "elevation": {
        "near": {
          "$type": "shadow",
          "$value": "{elevation.surface.flat}",
          "$description": "Flat - streaming cards sit flush, contrast carries hierarchy"
        },
        "default": {
          "$type": "shadow",
          "$value": "{elevation.surface.flat}"
        },
        "far": {
          "$type": "shadow",
          "$value": "{elevation.surface.raised}",
          "$description": "Only the furthest tier lifts at all (e.g. a modal over the player bar)"
        },
        "none": {
          "$type": "shadow",
          "$value": "{elevation.surface.flat}"
        }
      }
    },
    "element": {
      "radius": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "9999px"
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{shape.radius.full}"
      }
    },
    "input": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "8px"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.hairline}"
        },
        "defaultStyle": {
          "$type": "strokeStyle",
          "$value": "{shape.border.style.solid}"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}"
        }
      }
    },
    "field": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "{shape.radius.04}"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.hairline}"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}"
        }
      }
    }
  },
  "spacing": {
    "component": {
      "padding": {
        "$type": "dimension",
        "$value": "20px"
      },
      "gap": {
        "$type": "dimension",
        "$value": "12px"
      }
    },
    "card": {
      "padding": {
        "$type": "dimension",
        "$value": "20px"
      }
    }
  },
  "motion": {
    "interaction": {
      "duration": {
        "$type": "duration",
        "$value": "140ms"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.quick.enter}",
        "$description": "Sharp start, smooth end - the 'snap into place' feel of a played track"
      }
    }
  },
  "typography": {
    "body": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{typography.weight.medium}",
          "$description": "Medium body weight (500) - confident, readable at high density"
        }
      }
    },
    "heading": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": 800
        }
      }
    },
    "semanticFamily": {
      "heading": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.sans}"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.inter}"
      }
    }
  },
  "components": {
    "Avatar": {
      "color": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.lime.100}",
            "$extensions": {
              "fsds.light": "{color.palette.lime.100}",
              "fsds.dark": "{color.palette.lime.900}"
            },
            "$description": "Component-scoped override: artist/profile avatars get a lime-tinted fill instead of the neutral-gray secondary background every other component sharing that semantic path still uses."
          }
        },
        "border": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.lime.300}",
            "$extensions": {
              "fsds.light": "{color.palette.lime.300}",
              "fsds.dark": "{color.palette.lime.700}"
            },
            "$description": "Subtle lime ring, distinct from the generic neutral avatar border"
          }
        }
      }
    },
    "Button": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          },
          "typography": {
            "weight": {
              "$type": "fontWeight",
              "$value": 700
            }
          }
        }
      }
    },
    "Input": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Card": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            },
            "gap": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.flat}"
            }
          }
        },
        "media": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      },
      "size": {
        "padding": {
          "inset": {
            "$type": "dimension",
            "$value": "12px",
            "$description": "Compact card variant retains less padding than the default surface."
          }
        }
      }
    },
    "CodeBlock": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Popover": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "16px"
            }
          }
        }
      }
    },
    "Dialog": {
      "design": {
        "modal": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "16px"
            }
          }
        }
      }
    },
    "Select": {
      "design": {
        "trigger": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        },
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          }
        },
        "option": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "6px"
            }
          }
        }
      }
    },
    "Badge": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Chip": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          }
        }
      }
    },
    "Tooltip": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Toast": {
      "design": {
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          }
        }
      }
    },
    "Walkthrough": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "16px"
            }
          }
        }
      }
    },
    "Accordion": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          }
        },
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Tabs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Breadcrumbs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    }
  }
}

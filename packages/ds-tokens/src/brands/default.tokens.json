{
  "$brand": {
    "name": "default",
    "description": "Neutral product foundation with moderate surface corners, compact controls and a clear sans-serif hierarchy.",
    "accent": "red",
    "density": "default"
  },
  "color": {
    "foreground": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.red.500}",
        "$extensions": {
          "fsds.light": "{color.palette.red.500}",
          "fsds.dark": "{color.palette.red.400}"
        }
      },
      "link": {
        "$type": "color",
        "$value": "{color.palette.red.500}",
        "$extensions": {
          "fsds.light": "{color.palette.red.500}",
          "fsds.dark": "{color.palette.red.400}"
        }
      },
      "linkHover": {
        "$type": "color",
        "$value": "{color.palette.red.600}",
        "$extensions": {
          "fsds.light": "{color.palette.red.600}",
          "fsds.dark": "{color.palette.red.300}"
        }
      },
      "linkVisited": {
        "$type": "color",
        "$value": "{color.palette.red.400}",
        "$extensions": {
          "fsds.light": "{color.palette.red.400}",
          "fsds.dark": "{color.palette.red.500}"
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.red.700}",
        "$extensions": {
          "fsds.light": "{color.palette.red.700}",
          "fsds.dark": "{color.palette.red.200}"
        }
      }
    },
    "background": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.red.500}",
        "$extensions": {
          "fsds.light": "{color.palette.red.500}",
          "fsds.dark": "{color.palette.red.500}"
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.red.200}",
        "$extensions": {
          "fsds.light": "{color.palette.red.200}",
          "fsds.dark": "{color.palette.red.700}"
        }
      }
    },
    "border": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.red.500}",
        "$extensions": {
          "fsds.light": "{color.palette.red.500}",
          "fsds.dark": "{color.palette.red.400}"
        }
      },
      "default": {
        "$type": "color",
        "$value": "{color.palette.neutral.300}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.300}",
          "fsds.dark": "{color.palette.neutral.600}"
        },
        "$description": "Default input border - simple neutral gray"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.palette.neutral.400}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.400}",
          "fsds.dark": "{color.palette.neutral.500}"
        },
        "$description": "Input hover border - neutral gray (structural, not accent)"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.palette.red.500}",
        "$extensions": {
          "fsds.light": "{color.palette.red.500}",
          "fsds.dark": "{color.palette.red.400}"
        },
        "$description": "Input focus border - bold red accent"
      },
      "light": {
        "$type": "color",
        "$value": "{color.palette.neutral.200}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.200}",
          "fsds.dark": "{color.palette.neutral.700}"
        },
        "$description": "Light border - subtle neutral hairline (structural, not accent)"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.palette.neutral.300}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.300}",
          "fsds.dark": "{color.palette.neutral.500}"
        },
        "$description": "Primary input border - neutral"
      }
    },
    "navigation": {
      "foreground": {
        "active": {
          "$type": "color",
          "$value": "{color.palette.red.500}",
          "$extensions": {
            "fsds.light": "{color.palette.red.500}",
            "fsds.dark": "{color.palette.red.400}"
          }
        }
      },
      "stateLayer": {
        "hover": {
          "$type": "number",
          "$value": "{interaction.stateLayer.hover}",
          "$description": "Nav hover state-layer opacity — tonal red overlay on hover"
        },
        "selected": {
          "$type": "number",
          "$value": "{interaction.stateLayer.selected}",
          "$description": "Nav selected/active state-layer opacity — tonal red overlay for active item"
        },
        "pressed": {
          "$type": "number",
          "$value": "{interaction.stateLayer.pressed}",
          "$description": "Nav pressed state-layer opacity — stronger tonal red overlay on press"
        }
      }
    },
    "action": {
      "background": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.red.500}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.palette.red.600}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.palette.red.700}"
          }
        }
      },
      "border": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.red.500}"
          },
          "focus": {
            "$type": "color",
            "$value": "{color.palette.red.400}"
          }
        }
      }
    },
    "status": {
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.red.400}",
        "$extensions": {
          "fsds.light": "{color.palette.red.400}",
          "fsds.dark": "{color.palette.red.500}"
        }
      }
    }
  },
  "shape": {
    "control": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "8px",
          "$description": "Default small control corner; content surfaces and actions have component-specific shape decisions."
        }
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "12px"
      },
      "border": {
        "light": {
          "$type": "color",
          "$value": "{color.palette.neutral.200}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.200}",
            "fsds.dark": "{color.palette.neutral.700}"
          },
          "$description": "Light card border - subtle neutral hairline (structural)"
        },
        "medium": {
          "$type": "color",
          "$value": "{color.palette.neutral.300}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.300}",
            "fsds.dark": "{color.palette.neutral.600}"
          },
          "$description": "Medium card border - neutral (structural)"
        },
        "dark": {
          "$type": "color",
          "$value": "{color.palette.neutral.400}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.400}",
            "fsds.dark": "{color.palette.neutral.500}"
          },
          "$description": "Dark card border - stronger neutral (structural)"
        },
        "transparent": {
          "$type": "color",
          "$value": "{color.mode.transparent}",
          "$extensions": {
            "fsds.light": "{color.mode.transparent}",
            "fsds.dark": "{color.mode.transparent}"
          },
          "$description": "Transparent card border - no border"
        }
      },
      "elevation": {
        "near": {
          "$type": "shadow",
          "$value": "{elevation.surface.raised}",
          "$description": "Near elevation - resting card surface, light raised shadow"
        },
        "default": {
          "$type": "shadow",
          "$value": "{elevation.surface.raised}",
          "$description": "Default elevation - standard raised shadow"
        },
        "far": {
          "$type": "shadow",
          "$value": "{elevation.surface.floating}",
          "$description": "Far elevation - floating surface, prominent shadow"
        },
        "none": {
          "$type": "shadow",
          "$value": "{elevation.surface.flat}",
          "$description": "No elevation - flat cards, flush with page"
        }
      }
    },
    "element": {
      "radius": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{shape.radius.full}",
        "$description": "Badge/chip radius (pill)"
      }
    },
    "input": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "8px"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.hairline}",
          "$description": "Input border width - standard (1px)"
        },
        "defaultStyle": {
          "$type": "strokeStyle",
          "$value": "{shape.border.style.solid}",
          "$description": "Input border style - solid"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}",
          "$description": "Input focus border width - emphasized (2px)"
        }
      }
    },
    "field": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "{shape.radius.03}",
          "$description": "Field border radius - balanced (8px)"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.hairline}",
          "$description": "Field border width - standard (1px)"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}",
          "$description": "Field focus border width - emphasized (2px)"
        }
      }
    }
  },
  "spacing": {
    "component": {
      "padding": {
        "$type": "dimension",
        "$value": "20px"
      },
      "gap": {
        "$type": "dimension",
        "$value": "12px"
      }
    },
    "card": {
      "padding": {
        "$type": "dimension",
        "$value": "20px"
      }
    }
  },
  "motion": {
    "interaction": {
      "duration": {
        "$type": "duration",
        "$value": "200ms"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.standard}",
        "$description": "Standard easing curve"
      }
    }
  },
  "typography": {
    "body": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{typography.weight.regular}",
          "$description": "Regular body weight (400)"
        }
      }
    },
    "heading": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": 500
        }
      }
    },
    "semanticFamily": {
      "heading": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.sans}"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.inter}"
      }
    }
  },
  "components": {
    "Button": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          },
          "typography": {
            "weight": {
              "$type": "fontWeight",
              "$value": 500
            }
          }
        }
      }
    },
    "Input": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Card": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            },
            "gap": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "1px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.flat}"
            }
          }
        },
        "media": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      },
      "size": {
        "padding": {
          "inset": {
            "$type": "dimension",
            "$value": "12px",
            "$description": "Compact card variant retains less padding than the default surface."
          }
        }
      }
    },
    "CodeBlock": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "6px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Popover": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "1px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "16px"
            }
          }
        }
      }
    },
    "Dialog": {
      "design": {
        "modal": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "14px"
            }
          }
        }
      }
    },
    "Select": {
      "design": {
        "trigger": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        },
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "1px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          }
        },
        "option": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "6px"
            }
          }
        }
      }
    },
    "Badge": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Chip": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          }
        }
      }
    },
    "Tooltip": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Toast": {
      "design": {
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          }
        }
      }
    },
    "Walkthrough": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "14px"
            }
          }
        }
      }
    },
    "Accordion": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          }
        },
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Tabs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Breadcrumbs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    }
  }
}

{
  "$brand": {
    "name": "quickserve",
    "description": "Expressive, spacious UI with heavy headings, rounded raised cards, pill actions and brisk motion.",
    "accent": "orange",
    "density": "spacious"
  },
  "color": {
    "foreground": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.orange.600}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.600}",
          "fsds.dark": "{color.palette.orange.300}"
        }
      },
      "link": {
        "$type": "color",
        "$value": "{color.palette.orange.600}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.600}",
          "fsds.dark": "{color.palette.orange.300}"
        }
      },
      "linkHover": {
        "$type": "color",
        "$value": "{color.palette.orange.700}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.700}",
          "fsds.dark": "{color.palette.orange.200}"
        }
      },
      "linkVisited": {
        "$type": "color",
        "$value": "{color.palette.orange.500}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.500}",
          "fsds.dark": "{color.palette.orange.400}"
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.orange.800}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.800}",
          "fsds.dark": "{color.palette.orange.100}"
        }
      }
    },
    "background": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.orange.600}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.600}",
          "fsds.dark": "{color.palette.orange.600}"
        },
        "$description": "Accent fill - orange.600, ~6.8:1 against white text in both modes"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.orange.100}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.100}",
          "fsds.dark": "{color.palette.orange.800}"
        }
      }
    },
    "border": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.orange.600}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.600}",
          "fsds.dark": "{color.palette.orange.400}"
        }
      },
      "default": {
        "$type": "color",
        "$value": "{color.palette.neutral.200}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.200}",
          "fsds.dark": "{color.palette.neutral.700}"
        },
        "$description": "Kept neutral - bold color blocks carry the design, not colored borders"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.palette.orange.400}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.400}",
          "fsds.dark": "{color.palette.orange.500}"
        }
      },
      "focus": {
        "$type": "color",
        "$value": "{color.palette.orange.600}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.600}",
          "fsds.dark": "{color.palette.orange.400}"
        }
      },
      "light": {
        "$type": "color",
        "$value": "{color.palette.neutral.100}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.100}",
          "fsds.dark": "{color.palette.neutral.800}"
        }
      },
      "primary": {
        "$type": "color",
        "$value": "{color.palette.neutral.300}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.300}",
          "fsds.dark": "{color.palette.neutral.500}"
        }
      }
    },
    "navigation": {
      "foreground": {
        "active": {
          "$type": "color",
          "$value": "{color.palette.orange.600}",
          "$extensions": {
            "fsds.light": "{color.palette.orange.600}",
            "fsds.dark": "{color.palette.orange.300}"
          }
        }
      },
      "stateLayer": {
        "hover": {
          "$type": "number",
          "$value": "{interaction.stateLayer.hover}"
        },
        "selected": {
          "$type": "number",
          "$value": "{interaction.stateLayer.selected}"
        },
        "pressed": {
          "$type": "number",
          "$value": "{interaction.stateLayer.pressed}"
        }
      }
    },
    "action": {
      "background": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.orange.600}",
            "$description": "Primary CTA fill - orange.600"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.palette.orange.700}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.palette.orange.800}"
          }
        }
      },
      "border": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.orange.600}"
          },
          "focus": {
            "$type": "color",
            "$value": "{color.palette.orange.400}"
          }
        }
      }
    },
    "status": {
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.orange.300}",
        "$extensions": {
          "fsds.light": "{color.palette.orange.300}",
          "fsds.dark": "{color.palette.orange.400}"
        }
      }
    }
  },
  "shape": {
    "control": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Default small control corner; content surfaces and actions have component-specific shape decisions."
        }
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "20px"
      },
      "border": {
        "light": {
          "$type": "color",
          "$value": "{color.palette.neutral.100}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.100}",
            "fsds.dark": "{color.palette.neutral.800}"
          }
        },
        "medium": {
          "$type": "color",
          "$value": "{color.palette.neutral.200}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.200}",
            "fsds.dark": "{color.palette.neutral.700}"
          }
        },
        "dark": {
          "$type": "color",
          "$value": "{color.palette.neutral.400}",
          "$extensions": {
            "fsds.light": "{color.palette.neutral.400}",
            "fsds.dark": "{color.palette.neutral.500}"
          }
        },
        "transparent": {
          "$type": "color",
          "$value": "{color.mode.transparent}",
          "$extensions": {
            "fsds.light": "{color.mode.transparent}",
            "fsds.dark": "{color.mode.transparent}"
          }
        }
      },
      "elevation": {
        "near": {
          "$type": "shadow",
          "$value": "{elevation.surface.raised}",
          "$description": "Even resting cards pop with a visible shadow - punchy from the start"
        },
        "default": {
          "$type": "shadow",
          "$value": "{elevation.surface.floating}"
        },
        "far": {
          "$type": "shadow",
          "$value": "{elevation.surface.overlay}"
        },
        "none": {
          "$type": "shadow",
          "$value": "{elevation.surface.flat}"
        }
      }
    },
    "element": {
      "radius": {
        "$type": "dimension",
        "$value": "12px"
      }
    },
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "9999px"
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{shape.radius.full}",
        "$description": "Pill tag - 'NEW!' / 'LIMITED TIME' badges"
      }
    },
    "input": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "12px"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}",
          "$description": "Thick border (2px) - bold, tactile"
        },
        "defaultStyle": {
          "$type": "strokeStyle",
          "$value": "{shape.border.style.solid}"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}"
        }
      }
    },
    "field": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "{shape.radius.04}"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}"
        }
      }
    }
  },
  "spacing": {
    "component": {
      "padding": {
        "$type": "dimension",
        "$value": "24px"
      },
      "gap": {
        "$type": "dimension",
        "$value": "12px"
      }
    },
    "card": {
      "padding": {
        "$type": "dimension",
        "$value": "24px"
      }
    }
  },
  "motion": {
    "interaction": {
      "duration": {
        "$type": "duration",
        "$value": "120ms"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.bounce}",
        "$description": "Playful overshoot - the 'added to order' pop"
      }
    }
  },
  "typography": {
    "body": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{typography.weight.medium}"
        }
      }
    },
    "heading": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": 800
        }
      }
    },
    "semanticFamily": {
      "heading": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.sans}"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.inter}"
      }
    }
  },
  "components": {
    "Badge": {
      "color": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.orange.600}",
            "$extensions": {
              "fsds.light": "{color.palette.orange.600}",
              "fsds.dark": "{color.palette.orange.500}"
            },
            "$description": "Component-scoped override: 'limited time' tags get a bold orange fill instead of the generic neutral secondary background every other badge-shaped surface still uses."
          }
        },
        "foreground": {
          "primary": {
            "$type": "color",
            "$value": "{color.mode.light}",
            "$description": "Fixed near-white text on the bold orange fill (clears AA against orange.600/500)"
          }
        },
        "border": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.orange.700}",
            "$extensions": {
              "fsds.light": "{color.palette.orange.700}",
              "fsds.dark": "{color.palette.orange.400}"
            }
          }
        }
      },
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Button": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          },
          "typography": {
            "weight": {
              "$type": "fontWeight",
              "$value": 700
            }
          }
        }
      }
    },
    "Input": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          }
        }
      }
    },
    "Card": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "24px"
            },
            "gap": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.raised}"
            }
          }
        },
        "media": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "16px"
            }
          }
        }
      },
      "size": {
        "padding": {
          "inset": {
            "$type": "dimension",
            "$value": "16px",
            "$description": "Compact card variant retains less padding than the default surface."
          }
        }
      }
    },
    "CodeBlock": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Popover": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        }
      }
    },
    "Dialog": {
      "design": {
        "modal": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        }
      }
    },
    "Select": {
      "design": {
        "trigger": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          }
        },
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          }
        },
        "option": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          }
        }
      }
    },
    "Chip": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          }
        }
      }
    },
    "Tooltip": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Toast": {
      "design": {
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          }
        }
      }
    },
    "Walkthrough": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        }
      }
    },
    "Accordion": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        },
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          }
        }
      }
    },
    "Tabs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Breadcrumbs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    }
  }
}

{
  "$brand": {
    "name": "canary",
    "description": "Amber-accented, spacious product UI with rounded surfaces, stronger headings and raised cards.",
    "accent": "yellow",
    "density": "default"
  },
  "color": {
    "foreground": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.yellow.600}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.600}",
          "fsds.dark": "{color.palette.yellow.300}"
        },
        "$description": "Accent foreground - text on page; light uses .600 (dark enough on white), dark uses .300 (bright against dark surfaces)"
      },
      "link": {
        "$type": "color",
        "$value": "{color.palette.yellow.600}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.600}",
          "fsds.dark": "{color.palette.yellow.300}"
        }
      },
      "linkHover": {
        "$type": "color",
        "$value": "{color.palette.yellow.700}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.700}",
          "fsds.dark": "{color.palette.yellow.200}"
        }
      },
      "linkVisited": {
        "$type": "color",
        "$value": "{color.palette.yellow.500}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.500}",
          "fsds.dark": "{color.palette.yellow.400}"
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.yellow.800}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.800}",
          "fsds.dark": "{color.palette.yellow.100}"
        },
        "$description": "Highlight text - deep amber in light, bright yellow tint in dark"
      }
    },
    "background": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.yellow.600}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.600}",
          "fsds.dark": "{color.palette.yellow.600}"
        },
        "$description": "Accent fill - yellow.600 passes WCAG AA with white text in both modes (approx 6.8:1)"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.yellow.100}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.100}",
          "fsds.dark": "{color.palette.yellow.800}"
        },
        "$description": "Warm yellow wash for highlight surfaces"
      }
    },
    "border": {
      "accent": {
        "$type": "color",
        "$value": "{color.palette.yellow.600}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.600}",
          "fsds.dark": "{color.palette.yellow.400}"
        },
        "$description": "Accent border - .600 light (strong presence), .400 dark (bright pop)"
      },
      "default": {
        "$type": "color",
        "$value": "{color.palette.neutral.300}",
        "$extensions": {
          "fsds.light": "{color.palette.neutral.300}",
          "fsds.dark": "{color.palette.neutral.600}"
        },
        "$description": "Default input border - neutral gray"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.palette.yellow.400}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.400}",
          "fsds.dark": "{color.palette.yellow.500}"
        },
        "$description": "Input hover border - warm amber pop"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.palette.yellow.600}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.600}",
          "fsds.dark": "{color.palette.yellow.400}"
        },
        "$description": "Input focus border - bold yellow accent ring"
      },
      "light": {
        "$type": "color",
        "$value": "{color.palette.yellow.100}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.100}",
          "fsds.dark": "{color.palette.yellow.800}"
        },
        "$description": "Light input border - delicate yellow tint"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.palette.yellow.300}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.300}",
          "fsds.dark": "{color.palette.yellow.600}"
        },
        "$description": "Primary input border - warm amber"
      }
    },
    "navigation": {
      "foreground": {
        "active": {
          "$type": "color",
          "$value": "{color.palette.yellow.600}",
          "$extensions": {
            "fsds.light": "{color.palette.yellow.600}",
            "fsds.dark": "{color.palette.yellow.300}"
          }
        }
      }
    },
    "action": {
      "background": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.yellow.600}",
            "$description": "Primary action fill - yellow.600 (approx 6.8:1 white text contrast)"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.palette.yellow.700}",
            "$description": "Primary action hover - yellow.700 (approx 9.4:1 white text contrast)"
          },
          "active": {
            "$type": "color",
            "$value": "{color.palette.yellow.800}",
            "$description": "Primary action pressed - yellow.800 (deep amber, very high contrast)"
          }
        }
      },
      "border": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": "{color.palette.yellow.600}"
          },
          "focus": {
            "$type": "color",
            "$value": "{color.palette.yellow.400}"
          }
        }
      }
    },
    "status": {
      "highlight": {
        "$type": "color",
        "$value": "{color.palette.yellow.300}",
        "$extensions": {
          "fsds.light": "{color.palette.yellow.300}",
          "fsds.dark": "{color.palette.yellow.400}"
        },
        "$description": "Status highlight - cheerful warm amber"
      }
    }
  },
  "shape": {
    "control": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "10px",
          "$description": "Default small control corner; content surfaces and actions have component-specific shape decisions."
        }
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "20px"
      },
      "border": {
        "light": {
          "$type": "color",
          "$value": "{color.palette.yellow.50}",
          "$extensions": {
            "fsds.light": "{color.palette.yellow.50}",
            "fsds.dark": "{color.palette.yellow.900}"
          },
          "$description": "Light card border - barely-there yellow wash"
        },
        "medium": {
          "$type": "color",
          "$value": "{color.palette.yellow.100}",
          "$extensions": {
            "fsds.light": "{color.palette.yellow.100}",
            "fsds.dark": "{color.palette.yellow.800}"
          },
          "$description": "Medium card border - warm subtle yellow"
        },
        "dark": {
          "$type": "color",
          "$value": "{color.palette.yellow.300}",
          "$extensions": {
            "fsds.light": "{color.palette.yellow.300}",
            "fsds.dark": "{color.palette.yellow.600}"
          },
          "$description": "Dark card border - vivid amber accent ring"
        },
        "transparent": {
          "$type": "color",
          "$value": "{color.mode.transparent}",
          "$extensions": {
            "fsds.light": "{color.mode.transparent}",
            "fsds.dark": "{color.mode.transparent}"
          },
          "$description": "Transparent card border - no border"
        }
      },
      "elevation": {
        "near": {
          "$type": "shadow",
          "$value": "{elevation.surface.raised}",
          "$description": "Resting card elevation"
        },
        "default": {
          "$type": "shadow",
          "$value": "{elevation.surface.floating}",
          "$description": "Hovered/active card elevation"
        },
        "far": {
          "$type": "shadow",
          "$value": "{elevation.surface.overlay}",
          "$description": "Prominent card elevation - floating above siblings"
        },
        "none": {
          "$type": "shadow",
          "$value": "{elevation.surface.flat}",
          "$description": "Flat card - no shadow"
        }
      }
    },
    "element": {
      "radius": {
        "$type": "dimension",
        "$value": "10px"
      }
    },
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "12px"
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{shape.radius.full}",
        "$description": "Badge/chip radius - pill shape for cheerful badges"
      }
    },
    "input": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "10px"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}",
          "$description": "Input border width - thick for lively, tactile feel (2px)"
        },
        "defaultStyle": {
          "$type": "strokeStyle",
          "$value": "{shape.border.style.solid}",
          "$description": "Input border style - solid"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}",
          "$description": "Input focus border width - bold ring (2px)"
        }
      }
    },
    "field": {
      "radius": {
        "default": {
          "$type": "dimension",
          "$value": "{shape.radius.04}",
          "$description": "Field border radius - generously rounded (16px)"
        }
      },
      "border": {
        "defaultWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}",
          "$description": "Field border width - playful thickness (2px)"
        },
        "focusWidth": {
          "$type": "dimension",
          "$value": "{shape.border.width.thick}",
          "$description": "Field focus border width - bold accent ring (2px)"
        }
      }
    }
  },
  "spacing": {
    "component": {
      "padding": {
        "$type": "dimension",
        "$value": "24px"
      },
      "gap": {
        "$type": "dimension",
        "$value": "16px"
      }
    },
    "card": {
      "padding": {
        "$type": "dimension",
        "$value": "24px"
      }
    }
  },
  "motion": {
    "interaction": {
      "duration": {
        "$type": "duration",
        "$value": "180ms"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.bounce}",
        "$description": "Bounce easing - playful slight overshoot on interactions"
      }
    }
  },
  "typography": {
    "body": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{typography.weight.medium}",
          "$description": "Medium body weight (500) - energetic, readable"
        }
      }
    },
    "heading": {
      "font": {
        "weight": {
          "$type": "fontWeight",
          "$value": 700
        }
      }
    },
    "semanticFamily": {
      "heading": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.sans}"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{core.typography.font.family.inter}"
      }
    }
  },
  "components": {
    "Button": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "12px"
            }
          },
          "typography": {
            "weight": {
              "$type": "fontWeight",
              "$value": 700
            }
          }
        }
      }
    },
    "Input": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          }
        }
      }
    },
    "Card": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "24px"
            },
            "gap": {
              "$type": "dimension",
              "$value": "16px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "1px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.raised}"
            }
          }
        },
        "media": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "16px"
            }
          }
        }
      },
      "size": {
        "padding": {
          "inset": {
            "$type": "dimension",
            "$value": "16px",
            "$description": "Compact card variant retains less padding than the default surface."
          }
        }
      }
    },
    "CodeBlock": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Popover": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "14px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "1px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          },
          "spacing": {
            "padding": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        }
      }
    },
    "Dialog": {
      "design": {
        "modal": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        }
      }
    },
    "Select": {
      "design": {
        "trigger": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          }
        },
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "14px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "1px"
            }
          },
          "elevation": {
            "shadow": {
              "$type": "shadow",
              "$value": "{semantic.elevation.surface.overlay}"
            }
          }
        },
        "option": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Badge": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          },
          "border": {
            "width": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Chip": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "9999px"
            }
          }
        }
      }
    },
    "Tooltip": {
      "design": {
        "content": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "8px"
            }
          }
        }
      }
    },
    "Toast": {
      "design": {
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "14px"
            }
          }
        }
      }
    },
    "Walkthrough": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        }
      }
    },
    "Accordion": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "20px"
            }
          }
        },
        "item": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "10px"
            }
          }
        }
      }
    },
    "Tabs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    },
    "Breadcrumbs": {
      "design": {
        "root": {
          "shape": {
            "radius": {
              "$type": "dimension",
              "$value": "0px"
            }
          }
        }
      }
    }
  }
}

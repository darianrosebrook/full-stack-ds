/* Unity pilot theme authority. These defaults are not a projection of the
   complete Web token graph. All selectors are scoped to package-owned roots. */
.fsds-theme {
    --fsds-text: #eef1f7;
    --fsds-muted-text: #b9c3d4;
    --fsds-background: #171d29;
    --fsds-surface: #222b3a;
    --fsds-hover: #303d51;
    --fsds-border: #53647d;
    --fsds-accent: #295bb5;
    --fsds-focus: #a9ceff;
    color: var(--fsds-text);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
    flex-shrink: 0;
    min-width: 0;
}
.fsds-theme .unity-text-element {
    color: var(--fsds-text);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
    min-width: 0;
}
.fsds-theme .unity-label { margin: 0; padding: 0; }
.fsds-theme .unity-button {
    color: var(--fsds-text);
    background-color: var(--fsds-surface);
    background-image: none;
    font-size: 16px;
    min-height: 40px;
    flex-shrink: 0;
    margin: 0;
    padding: 8px 12px;
    border-width: 1px;
    border-color: var(--fsds-border);
    border-radius: 6px;
    -unity-text-align: middle-left;
    white-space: normal;
}
.fsds-theme .unity-button:hover { background-color: var(--fsds-hover); }
.fsds-theme .unity-button:active { background-color: var(--fsds-accent); }
.fsds-theme .unity-button:focus { border-width: 2px; border-color: var(--fsds-focus); }
.fsds-theme .unity-button:disabled { opacity: 0.5; }
.fsds-theme .fsds-toggle-trigger {
    background-color: transparent;
    border-color: transparent;
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
}
.fsds-theme .fsds-toggle-trigger:hover { background-color: var(--fsds-surface); }
.fsds-theme .fsds-toggle-trigger:focus { border-color: var(--fsds-focus); }
.fsds-toggle-track {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--fsds-border);
    border-radius: 16px;
    padding: 3px;
    margin-right: 12px;
}
.fsds-theme.is-checked .fsds-toggle-track {
    background-color: var(--fsds-accent);
    justify-content: flex-end;
}
.fsds-toggle-thumb { flex-shrink: 0; background-color: #ffffff; border-radius: 12px; }
.fsds-toggle-caption { flex-shrink: 1; flex-grow: 1; }
.fsds-item { margin-bottom: 8px; min-width: 0; }
.fsds-theme .fsds-disclosure-trigger { flex-direction: row; justify-content: space-between; }
.fsds-item-caption { flex-grow: 1; flex-shrink: 1; }
.fsds-theme .fsds-disclosure-marker { flex-shrink: 0; margin-left: 16px; -unity-text-align: middle-center; }
.fsds-theme .fsds-disclosure-trigger.is-selected { background-color: var(--fsds-surface); border-color: var(--fsds-focus); }
.fsds-item-content { padding: 12px; }
.fsds-tab-list { margin-bottom: 8px; flex-wrap: wrap; }
.fsds-theme .fsds-tab-trigger { margin-right: 6px; margin-bottom: 6px; }
.fsds-theme .fsds-tab-trigger.is-selected { background-color: var(--fsds-accent); }
.fsds-surface {
    position: absolute;
    background-color: var(--fsds-surface);
    border-width: 1px;
    border-color: var(--fsds-border);
    border-radius: 8px;
    min-width: 0;
    width: 320px;
    overflow: hidden;
}
.fsds-surface .unity-scroll-view__content-container { padding: 16px; }
.fsds-surface .unity-button { margin-top: 12px; }
.fsds-surface .unity-label { flex-shrink: 1; white-space: normal; }
.fsds-sample {
    height: 100%;
    flex-shrink: 1;
    background-color: var(--fsds-background);
    padding: 24px;
    flex-grow: 1;
    min-width: 0;
}
.fsds-sample-body { max-width: 640px; align-self: stretch; min-width: 0; }
.fsds-theme .fsds-sample-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 8px; }
.fsds-theme .fsds-sample-description { color: var(--fsds-muted-text); margin-bottom: 24px; }
.fsds-sample-section { margin-top: 20px; }

.fsds-theme .unity-scroller { background-color: var(--fsds-background); }
.fsds-theme .unity-base-slider__tracker { background-color: var(--fsds-background); }
.fsds-theme .unity-base-slider__dragger { background-color: var(--fsds-border); border-width: 0; border-radius: 6px; }

.fsds-theme .unity-scroller__low-button, .fsds-theme .unity-scroller__high-button { background-color: var(--fsds-border); }

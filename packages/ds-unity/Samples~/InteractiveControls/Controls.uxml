<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ds="FullStackDS">
    <Style src="/Packages/com.fullstackds.ui/Runtime/Resources/FullStackDS/Controls.uss" />
    <ui:ScrollView class="fsds-theme fsds-sample">
        <ui:VisualElement class="fsds-sample-body">
            <ui:Label text="Your experience" class="fsds-sample-title" />
            <ui:Label text="Preferences and content, built with Full Stack DS." class="fsds-sample-description" />
            <ds:Switch name="sound" label="Enable sound" checked="true" />
            <ds:Accordion name="settings" collapsible="true" value="graphics" class="fsds-sample-section">
                <ds:AccordionItem value="graphics" label="Graphics">
                    <ui:Label text="Adjust the quality of your experience." />
                    <ds:Switch label="High quality textures" />
                </ds:AccordionItem>
                <ds:AccordionItem value="audio" label="Audio">
                    <ui:Label text="Music and sound effects settings." />
                </ds:AccordionItem>
            </ds:Accordion>
            <ds:Tabs name="pages" value="overview" class="fsds-sample-section">
                <ds:TabsItem value="overview" label="Overview"><ui:Label text="Your adventure starts here." /></ds:TabsItem>
                <ds:TabsItem value="inventory" label="Inventory"><ui:Label text="Your collected items appear here." /></ds:TabsItem>
                <ds:TabsItem value="locked" label="Locked" disabled="true"><ui:Label text="Not available yet." /></ds:TabsItem>
            </ds:Tabs>
            <ds:Popover name="help" label="About these controls" placement="bottom" class="fsds-sample-section">
                <ui:Label text="Contract-generated UI Toolkit components. These controls share one interaction contract across the Editor and your game." />
                <ui:Button text="Focusable content" />
            </ds:Popover>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
